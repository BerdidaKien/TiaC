@model ASI.Basecode.Services.ServiceModels.CustodianProfileViewModel
@{
    ViewData["Title"] = "Custodian Profile";
    var photoUrl = string.IsNullOrWhiteSpace(Model.ProfileImagePath) ? null : Model.ProfileImagePath;
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
}

<div class="dash-header mb-4">
    <h1 class="dash dash-name m-0">Profile</h1>
    <p class="dash-sub">Manage your photo and contact details.</p>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form method="post" asp-controller="Custodian" asp-action="Profile" enctype="multipart/form-data" id="profileForm">
    @Html.AntiForgeryToken()

    <div class="row g-4 mb-4">
        <!-- Left: Profile picture -->
        <div class="col-md-4">
            <div class="dash-card text-center h-100 d-flex flex-column justify-content-between">
                <div>
                    <h5 class="dash fw-bold border-bottom pb-2 mb-3"><i class="bi bi-person-circle me-1"></i> Profile Picture</h5>

                    <div class="position-relative d-inline-block mx-auto mb-3">
                        <div class="rounded-circle bg-white d-flex align-items-center justify-content-center border border-3 border-danger overflow-hidden"
                             style="width: 120px; height: 120px;">
                            <i id="photoIcon" class="bi bi-person-fill fs-1 text-secondary @(photoUrl != null ? "d-none" : "")"></i>
                            <img id="photoPreview" class="@(photoUrl == null ? "d-none" : "")" src="@photoUrl" alt="Profile photo"
                                 style="width:100%; height:100%; object-fit:cover;" />
                        </div>
                        <label for="photoInput" class="position-absolute bottom-0 end-0 bg-danger text-white rounded-circle p-2 shadow-sm"
                               style="cursor:pointer;" title="Change photo">
                            <i class="bi bi-camera-fill small"></i>
                        </label>
                    </div>

                    <div class="dash fw-bold fs-5 text-uppercase mb-2">@Model.FullName</div>

                    <input type="file" id="photoInput" name="photo" accept="image/png,image/jpeg,image/webp" class="d-none" />
                </div>

                <div>
                    <label for="photoInput" class="btn btn-outline-danger btn-sm w-100 mt-3 mb-0">
                        <i class="bi bi-camera me-1"></i> Change Photo
                    </label>
                    <div class="text-muted small mt-2">JPG, PNG or WEBP, up to 5 MB. Click <strong>Save Changes</strong> to apply.</div>
                </div>
            </div>
        </div>

        <!-- Right: Personal information -->
        <div class="col-md-8">
            <div class="dash-card h-100">
                <h5 class="dash fw-bold border-bottom pb-2 mb-3"><i class="bi bi-person-gear me-1"></i> Personal Information</h5>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="dash-stat-label mb-1" for="FirstName">First Name</label>
                        <input type="text" id="FirstName" class="form-control bg-light text-muted" value="@Model.FirstName" readonly disabled />
                    </div>
                    <div class="col-md-4">
                        <label class="dash-stat-label mb-1" for="MiddleName">Middle Name</label>
                        <input type="text" id="MiddleName" class="form-control bg-light text-muted" value="@Model.MiddleName" readonly disabled />
                    </div>
                    <div class="col-md-4">
                        <label class="dash-stat-label mb-1" for="LastName">Last Name</label>
                        <input type="text" id="LastName" class="form-control bg-light text-muted" value="@Model.LastName" readonly disabled />
                    </div>

                    <div class="col-md-6">
                        <label class="dash-stat-label mb-1" for="EmployeeId">Employee ID</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-card-heading"></i></span>
                            <input type="text" id="EmployeeId" class="form-control bg-light text-muted" value="@Model.EmployeeId" readonly disabled />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="dash-stat-label mb-1" for="Email">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                            <input type="email" id="Email" class="form-control bg-light text-muted" value="@Model.Email" readonly disabled />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="dash-stat-label mb-1" for="ContactNumber">Contact Number</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-telephone"></i></span>
                            <input type="text" id="ContactNumber" name="contactNumber" value="@Model.ContactNumber" maxlength="20"
                                   placeholder="09XX XXX XXXX" class="form-control dash-search-input editable-field" readonly />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="dash-stat-label mb-1" for="Role">Account / Role</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-shield-lock"></i></span>
                            <input type="text" id="Role" class="form-control bg-light text-muted" value="@Model.Role" readonly disabled />
                        </div>
                    </div>
                </div>

                <div class="alert alert-light border small mt-4 mb-0 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <span><i class="bi bi-info-circle me-1"></i> Your name, ID and email are verified records. If something is wrong, an administrator can correct it after reviewing proof.</span>
                    <a asp-controller="InfoRequest" asp-action="Create" class="btn btn-sm btn-outline-danger">
                        <i class="bi bi-file-earmark-person me-1"></i> Request a correction
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Activity -->
    <div class="dash-card mb-4">
        <div class="row g-3">
            <div class="col-md-3">
                <div class="d-flex align-items-center gap-3 p-2 border rounded bg-white">
                    <div class="p-2 @(Model.IsActive ? "bg-success" : "bg-danger") text-white rounded-circle"><i class="bi bi-check-circle-fill"></i></div>
                    <div>
                        <div class="fw-bold text-dark">@(Model.IsActive ? "Active" : "Inactive")</div>
                        <div class="small text-muted">Account Status</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="d-flex align-items-center gap-3 p-2 border rounded bg-white">
                    <div class="p-2 bg-danger text-white rounded-circle"><i class="bi bi-calendar3"></i></div>
                    <div>
                        <div class="fw-bold text-dark">@Model.CreatedTime.ToString("MMM yyyy")</div>
                        <div class="small text-muted">Date Joined</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="d-flex align-items-center gap-3 p-2 border rounded bg-white">
                    <div class="p-2 bg-info text-white rounded-circle"><i class="bi bi-file-earmark-check"></i></div>
                    <div>
                        <div class="fw-bold text-dark">@Model.ApprovedRequestsCount</div>
                        <div class="small text-muted">Requests You Approved</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="d-flex align-items-center gap-3 p-2 border rounded bg-white">
                    <div class="p-2 bg-warning text-dark rounded-circle"><i class="bi bi-box-arrow-in-down"></i></div>
                    <div>
                        <div class="fw-bold text-dark">@Model.CompletedBorrowingsCount</div>
                        <div class="small text-muted">Returns You Received</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-3">
        <button type="button" class="btn btn-outline-danger" id="toggleEditBtn">
            <i class="bi bi-pencil me-1"></i> Edit Contact
        </button>
        <button type="submit" class="btn dash-btn-reserve fw-bold" id="saveProfileBtn" disabled>
            <i class="bi bi-floppy me-1"></i> Save Changes
        </button>
    </div>
</form>

@section Scripts {
    <script>
        (function() {
            var editBtn = document.getElementById('toggleEditBtn');
            var saveBtn = document.getElementById('saveProfileBtn');
            var field = document.getElementById('ContactNumber');
            var original = field.value;
            var editing = false;

            // Only the contact number can be edited
            editBtn.addEventListener('click', function() {
                editing = !editing;
                field.readOnly = !editing;
                field.style.backgroundColor = editing ? '#ffffff' : '';

                if (!editing) { field.value = original; }

                saveBtn.disabled = !editing && !document.getElementById('photoInput').files.length;
                editBtn.innerHTML = editing
                    ? '<i class="bi bi-x-circle me-1"></i> Cancel'
                    : '<i class="bi bi-pencil me-1"></i> Edit Contact';

                if (editing) { field.focus(); }
            });

            // Photo preview, with the same checks the server makes
            var photoInput = document.getElementById('photoInput');
            var preview = document.getElementById('photoPreview');
            var icon = document.getElementById('photoIcon');
            var allowed = ['image/jpeg', 'image/png', 'image/webp'];

            photoInput.addEventListener('change', function() {
                var file = photoInput.files && photoInput.files[0];
                if (!file) return;

                if (allowed.indexOf(file.type) === -1) {
                    alert('Please choose a JPG, PNG or WEBP image.');
                    photoInput.value = '';
                    return;
                }
                if (file.size > 5 * 1024 * 1024) {
                    alert('The photo must be 5 MB or smaller.');
                    photoInput.value = '';
                    return;
                }

                preview.src = URL.createObjectURL(file);
                preview.classList.remove('d-none');
                icon.classList.add('d-none');
                saveBtn.disabled = false;
            });
        })();
    </script>
}