@model ASI.Basecode.Services.ServiceModels.CustodianProfileViewModel
@{
    ViewData["Title"] = "Custodian Profile";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
}

<div class="dash-header mb-4">
    <h1 class="dash dash-name m-0">Profile</h1>
    <p class="dash-sub">Manage your personal information and account details.</p>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form method="post" asp-controller="Custodian" asp-action="Profile" id="profileForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="row g-4 mb-4">
        <!-- Left: Profile Avatar Card -->
        <div class="col-md-4">
            <div class="dash-card text-center h-100 d-flex flex-column justify-content-between">
                <div>
                    <h5 class="dash fw-bold border-bottom pb-2 mb-3"><i class="bi bi-person-circle me-1"></i> Profile Picture</h5>
                    <div class="position-relative d-inline-block mx-auto mb-3">
                        <div class="rounded-circle bg-white d-flex align-items-center justify-content-center border border-3 border-danger" style="width: 120px; height: 120px;">
                            <i class="bi bi-person-fill fs-1 text-secondary"></i>
                        </div>
                        <span class="position-absolute bottom-0 end-0 bg-danger text-white rounded-circle p-2 shadow-sm">
                            <i class="bi bi-camera-fill small"></i>
                        </span>
                    </div>
                    <div class="dash fw-bold fs-5 text-uppercase mb-2" id="displayFullName">@Model.FullName</div>
                </div>
                <button type="button" class="btn btn-outline-danger btn-sm w-100 mt-3" id="btnChangePhoto" disabled>
                    <i class="bi bi-camera me-1"></i> Change Photo
                </button>
            </div>
        </div>

        <!-- Right: Personal Information Fields -->
        <div class="col-md-8">
            <div class="dash-card h-100">
                <h5 class="dash fw-bold border-bottom pb-2 mb-3"><i class="bi bi-person-gear me-1"></i> Personal Information</h5>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="dash-stat-label mb-1" for="FirstName">First Name *</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-person"></i></span>
                            <input type="text" id="FirstName" name="FirstName" class="form-control dash-search-input editable-field" value="@Model.FirstName" readonly required />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="dash-stat-label mb-1" for="LastName">Last Name *</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-person"></i></span>
                            <input type="text" id="LastName" name="LastName" class="form-control dash-search-input editable-field" value="@Model.LastName" readonly required />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="dash-stat-label mb-1" for="ContactNumber">Contact Number</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-telephone"></i></span>
                            <input type="text" id="ContactNumber" name="ContactNumber" class="form-control dash-search-input editable-field" value="@Model.ContactNumber" readonly />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="dash-stat-label mb-1" for="EmployeeId">Employee ID</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-card-heading"></i></span>
                            <input type="text" id="EmployeeId" class="form-control bg-light text-muted" value="@Model.EmployeeId" readonly disabled />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="dash-stat-label mb-1" for="Email">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                            <input type="email" id="Email" class="form-control bg-light text-muted" value="@Model.Email" readonly disabled />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="dash-stat-label mb-1" for="Role">Account / Role</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-shield-lock"></i></span>
                            <input type="text" id="Role" class="form-control bg-light text-muted" value="@Model.Role" readonly disabled />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Real Activity Metrics -->
    <div class="dash-card mb-4">
        <div class="row g-3">
            <div class="col-md-3">
                <div class="d-flex align-items-center gap-3 p-2 border rounded bg-white">
                    <div class="p-2 @(Model.IsActive ? "bg-success" : "bg-danger") text-white rounded-circle"><i class="bi bi-check-circle-fill"></i></div>
                    <div>
                        <div class="fw-bold text-dark">@(Model.IsActive ? "Active" : "Inactive")</div>
                        <div class="small text-muted">Account Status</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="d-flex align-items-center gap-3 p-2 border rounded bg-white">
                    <div class="p-2 bg-danger text-white rounded-circle"><i class="bi bi-calendar3"></i></div>
                    <div>
                        <div class="fw-bold text-dark">@Model.CreatedTime.ToString("MMM yyyy")</div>
                        <div class="small text-muted">Date Joined</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="d-flex align-items-center gap-3 p-2 border rounded bg-white">
                    <div class="p-2 bg-info text-white rounded-circle"><i class="bi bi-file-earmark-check"></i></div>
                    <div>
                        <div class="fw-bold text-dark">@Model.ApprovedRequestsCount</div>
                        <div class="small text-muted">Approved Requests</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="d-flex align-items-center gap-3 p-2 border rounded bg-white">
                    <div class="p-2 bg-warning text-dark rounded-circle"><i class="bi bi-box-arrow-up-right"></i></div>
                    <div>
                        <div class="fw-bold text-dark">@Model.CompletedBorrowingsCount</div>
                        <div class="small text-muted">Completed Borrowings</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-3">
        <button type="button" class="btn btn-outline-danger" id="toggleEditBtn">
            <i class="bi bi-pencil me-1"></i> Edit Profile
        </button>
        <button type="submit" class="btn dash-btn-reserve fw-bold" id="saveProfileBtn" disabled>
            <i class="bi bi-floppy me-1"></i> Save Changes
        </button>
    </div>
</form>

@section Scripts {
    <script>
        document.getElementById('toggleEditBtn').addEventListener('click', function() {
            var editableFields = document.querySelectorAll('.editable-field');
            var isEditing = editableFields[0].hasAttribute('readonly');

            editableFields.forEach(function(field) {
                if (isEditing) {
                    field.removeAttribute('readonly');
                    field.style.backgroundColor = '#ffffff';
                } else {
                    field.setAttribute('readonly', 'readonly');
                    field.style.backgroundColor = '#f6e6da';
                }
            });

            document.getElementById('saveProfileBtn').disabled = !isEditing;
            document.getElementById('btnChangePhoto').disabled = !isEditing;
            this.innerHTML = isEditing
                ? '<i class="bi bi-x-circle me-1"></i> Cancel'
                : '<i class="bi bi-pencil me-1"></i> Edit Profile';
        });
    </script>
}