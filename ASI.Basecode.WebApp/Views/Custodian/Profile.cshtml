@* Location: ASI.Basecode.WebApp/Views/Custodian/Profile.cshtml *@
@model ASI.Basecode.Services.ServiceModels.CustodianProfileViewModel
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Libre+Bodoni:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
}

@{
    ViewData["Title"] = "Custodian Profile";

    var fullName = string.IsNullOrWhiteSpace(Model.FullName) ? "Custodian" : Model.FullName;

    // The photo path is kept in the session (set at login and whenever a new photo is saved)
    var sessionPhoto = HttpContextAccessor.HttpContext?.Session.GetString("UserPhoto");
    var photoUrl = string.IsNullOrWhiteSpace(sessionPhoto) ? null : sessionPhoto;
}

<div class="dash profile">

    @* ===== Header ===== *@
    <div class="dash-header d-flex align-items-center justify-content-between pb-3 mb-3">
        <h1 class="dash-name mb-0">Profile</h1>
    </div>

    <p class="dash-sub profile-intro mb-3">
        Manage your personal information and account details.
    </p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success py-2" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger py-2" role="alert">
            @TempData["ErrorMessage"]
        </div>
    }

    <form asp-controller="Custodian" asp-action="Profile"
          method="post" enctype="multipart/form-data" id="profileForm">

        @Html.AntiForgeryToken()

        <div class="row">

            @* ===== Profile picture ===== *@
            <div class="col-lg-4 mb-4">
                <div class="dash-card profile-card h-100">

                    <div class="profile-card-title">
                        <i class="fa-solid fa-circle-user"></i>
                        <h2 class="dash-section-title mb-0">Profile Picture</h2>
                    </div>

                    <div class="text-center">
                        <div class="profile-photo-wrap">

                            <span class="profile-photo d-inline-flex align-items-center justify-content-center"
                                  id="photoCircle">

                                <i class="fa-solid fa-user @(photoUrl != null ? "d-none" : "")" id="photoIcon"></i>

                                <img id="photoPreview"
                                     class="@(photoUrl == null ? "d-none" : "")"
                                     src="@photoUrl"
                                     alt="Profile photo" />
                            </span>

                            <label for="photoInput"
                                   class="profile-camera"
                                   title="Change photo">
                                <i class="fa-solid fa-camera"></i>
                            </label>

                        </div>

                        <div class="profile-photo-name">
                            @fullName.ToUpper()
                        </div>

                        <input type="file"
                               id="photoInput"
                               name="photo"
                               accept="image/png,image/jpeg,image/webp"
                               class="d-none" />

                        <label for="photoInput"
                               class="btn dash-btn dash-btn-view profile-change-photo mb-0">
                            <i class="fa-solid fa-camera"></i> Change Photo
                        </label>

                        <div class="dash-muted small mt-2">JPG, PNG or WEBP, up to 5 MB. Click <strong>Save Changes</strong> to apply.</div>
                    </div>

                </div>
            </div>

            @* ===== Personal information ===== *@
            <div class="col-lg-8 mb-4">
                <div class="dash-card profile-card h-100">

                    <div class="profile-card-title">
                        <i class="fa-solid fa-user-gear"></i>
                        <h2 class="dash-section-title mb-0">Personal Information</h2>
                    </div>

                    <div class="row">

                        @* Employee ID *@
                        <div class="col-md-6 mb-3">
                            <label class="profile-label" for="EmployeeId">Employee ID</label>
                            <div class="profile-field position-relative">
                                <i class="fa-solid fa-id-card profile-field-icon"></i>
                                <input type="text" id="EmployeeId" value="@Model.EmployeeId"
                                       class="form-control profile-input" readonly />
                            </div>
                        </div>

                        @* First Name *@
                        <div class="col-md-6 mb-3">
                            <label class="profile-label" for="FirstName">First Name</label>
                            <div class="profile-field position-relative">
                                <i class="fa-solid fa-user profile-field-icon"></i>
                                <input type="text" id="FirstName" value="@Model.FirstName"
                                       class="form-control profile-input" readonly />
                            </div>
                        </div>

                        @* Last Name *@
                        <div class="col-md-6 mb-3">
                            <label class="profile-label" for="LastName">Last Name</label>
                            <div class="profile-field position-relative">
                                <i class="fa-solid fa-user profile-field-icon"></i>
                                <input type="text" id="LastName" value="@Model.LastName"
                                       class="form-control profile-input" readonly />
                            </div>
                        </div>

                        @* Contact Number (editable) *@
                        <div class="col-md-6 mb-3">
                            <label class="profile-label" for="ContactNumber">Contact Number</label>
                            <div class="profile-field position-relative">
                                <i class="fa-solid fa-phone profile-field-icon"></i>
                                <input type="text" id="ContactNumber" name="ContactNumber"
                                       value="@Model.ContactNumber" placeholder="09XX XXX XXXX"
                                       class="form-control profile-input" data-editable="true" readonly />
                            </div>
                        </div>

                        @* Email (editable) *@
                        <div class="col-md-6 mb-3">
                            <label class="profile-label" for="Email">Email Address</label>
                            <div class="profile-field position-relative">
                                <i class="fa-solid fa-envelope profile-field-icon"></i>
                                <input type="email" id="Email" name="Email"
                                       value="@Model.Email" placeholder="name@email.com"
                                       class="form-control profile-input" data-editable="true" readonly />
                            </div>
                        </div>

                        @* Role *@
                        <div class="col-md-6 mb-3">
                            <label class="profile-label" for="Role">Account Role</label>
                            <div class="profile-field position-relative">
                                <i class="fa-solid fa-user-tag profile-field-icon"></i>
                                <input type="text" id="Role" value="@Model.Role"
                                       class="form-control profile-input" readonly />
                            </div>
                        </div>

                        @* Account Status *@
                        <div class="col-md-6 mb-3">
                            <label class="profile-label" for="AccountStatus">Account Status</label>
                            <div class="profile-field position-relative">
                                <i class="fa-solid fa-circle-check profile-field-icon"></i>
                                <input type="text" id="AccountStatus" value="@(Model.IsActive ? "Active" : "Inactive")"
                                       class="form-control profile-input" readonly />
                            </div>
                        </div>

                        @* Change password *@
                        <div class="col-12 mb-1 d-flex flex-wrap" style="gap: 0.5rem 1.5rem;">
                            <a href="#"
                               class="dash-link"
                               data-toggle="modal"
                               data-target="#changePasswordModal"
                               data-bs-toggle="modal"
                               data-bs-target="#changePasswordModal">

                                <i class="fa-solid fa-key"></i> Change Password
                            </a>

                            <a asp-controller="InfoRequest"
                               asp-action="Create"
                               class="dash-link">

                                <i class="fa-solid fa-user-pen"></i> Request an information change
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        @* ===== Activity summary ===== *@
        <div class="row g-3 mb-4">
            <div class="col-6 col-xl-3">
                <div class="dash-card h-100 d-flex align-items-center gap-3">
                    <span class="dash-icon-circle dash-icon-lg d-inline-flex align-items-center justify-content-center">
                        <i class="fa-solid fa-circle-check"></i>
                    </span>
                    <div>
                        <div class="dash-stat-label mb-0">Account Status</div>
                        <div class="dash-section-title">@(Model.IsActive ? "Active" : "Inactive")</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-xl-3">
                <div class="dash-card h-100 d-flex align-items-center gap-3">
                    <span class="dash-icon-circle dash-icon-lg d-inline-flex align-items-center justify-content-center">
                        <i class="fa-regular fa-calendar"></i>
                    </span>
                    <div>
                        <div class="dash-stat-label mb-0">Date Joined</div>
                        <div class="dash-section-title">@Model.CreatedTime.ToString("MMM yyyy")</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-xl-3">
                <div class="dash-card h-100 d-flex align-items-center gap-3">
                    <span class="dash-icon-circle dash-icon-lg d-inline-flex align-items-center justify-content-center">
                        <i class="fa-solid fa-file-circle-check"></i>
                    </span>
                    <div>
                        <div class="dash-stat-label mb-0">Approved Requests</div>
                        <div class="dash-section-title">@Model.ApprovedRequestsCount</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-xl-3">
                <div class="dash-card h-100 d-flex align-items-center gap-3">
                    <span class="dash-icon-circle dash-icon-lg d-inline-flex align-items-center justify-content-center">
                        <i class="fa-solid fa-hand-holding"></i>
                    </span>
                    <div>
                        <div class="dash-stat-label mb-0">Completed Borrowings</div>
                        <div class="dash-section-title">@Model.CompletedBorrowingsCount</div>
                    </div>
                </div>
            </div>
        </div>

        @* ===== Actions ===== *@
        <div class="d-flex justify-content-end profile-actions">

            <button type="button" id="editBtn" class="btn profile-action profile-action-edit">
                <i class="fa-solid fa-pen"></i> Edit Profile
            </button>

            <button type="submit" id="saveBtn" class="btn profile-action profile-action-save ml-3 ms-3" disabled>
                <i class="fa-regular fa-floppy-disk"></i> Save Changes
            </button>

        </div>

    </form>

    @* ===== Change password modal ===== *@
    <div class="modal fade"
         id="changePasswordModal"
         tabindex="-1"
         role="dialog"
         aria-labelledby="changePasswordTitle"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content profile-modal">

                <form asp-controller="Account"
                      asp-action="ChangePassword"
                      method="post"
                      id="changePasswordForm"
                      novalidate>

                    @Html.AntiForgeryToken()

                    <div class="modal-header profile-modal-header">

                        <h5 class="modal-title dash-section-title" id="changePasswordTitle">
                            <i class="fa-solid fa-key"></i> Change Password
                        </h5>

                        <button type="button"
                                class="profile-modal-close"
                                data-dismiss="modal"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                            <i class="fa-solid fa-xmark"></i>
                        </button>

                    </div>

                    <div class="modal-body">

                        <div class="mb-3">
                            <label class="profile-label" for="CurrentPassword">Current Password</label>
                            <div class="profile-field position-relative">
                                <i class="fa-solid fa-lock profile-field-icon"></i>
                                <input type="password" id="CurrentPassword" name="CurrentPassword"
                                       class="form-control profile-input" autocomplete="current-password"
                                       placeholder="Enter your current password" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="profile-label" for="NewPassword">New Password</label>
                            <div class="profile-field position-relative">
                                <i class="fa-solid fa-key profile-field-icon"></i>
                                <input type="password" id="NewPassword" name="NewPassword"
                                       class="form-control profile-input" autocomplete="new-password"
                                       placeholder="Enter a new password" minlength="8" required />
                            </div>
                            <small class="dash-muted">At least 8 characters.</small>
                        </div>

                        <div class="mb-2">
                            <label class="profile-label" for="ConfirmPassword">Confirm New Password</label>
                            <div class="profile-field position-relative">
                                <i class="fa-solid fa-key profile-field-icon"></i>
                                <input type="password" id="ConfirmPassword" name="ConfirmPassword"
                                       class="form-control profile-input" autocomplete="new-password"
                                       placeholder="Re-enter your new password" required />
                            </div>
                        </div>

                        <div id="passwordError" class="text-danger small d-none"></div>

                    </div>

                    <div class="modal-footer profile-modal-footer">

                        <button type="button"
                                class="btn profile-action profile-action-edit"
                                data-dismiss="modal"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit" class="btn profile-action profile-action-save">
                            <i class="fa-regular fa-floppy-disk"></i> Update Password
                        </button>

                    </div>

                </form>
            </div>
        </div>
    </div>

</div>

@section Scripts {

    <script>
        (function () {
            var editBtn = document.getElementById('editBtn');
            var saveBtn = document.getElementById('saveBtn');

            // Only the contact number and email can be edited
            var inputs = document.querySelectorAll('.profile-input[data-editable="true"]');

            var editing = false;

            editBtn.addEventListener('click', function () {

                editing = !editing;

                inputs.forEach(function (input) {
                    input.readOnly = !editing;
                    input.classList.toggle('is-editing', editing);
                });

                saveBtn.disabled = !editing;

                editBtn.innerHTML = editing
                    ? '<i class="fa-solid fa-xmark"></i> Cancel'
                    : '<i class="fa-solid fa-pen"></i> Edit Profile';

                if (editing && inputs.length) {
                    inputs[0].focus();
                }
            });

            // Photo preview (+ type and 5 MB check before uploading)
            var photoInput = document.getElementById('photoInput');
            var preview = document.getElementById('photoPreview');
            var icon = document.getElementById('photoIcon');
            var allowed = ['image/jpeg', 'image/png', 'image/webp'];

            if (photoInput) {
                photoInput.addEventListener('change', function () {

                    var file = photoInput.files && photoInput.files[0];

                    if (!file) return;

                    if (allowed.indexOf(file.type) === -1) {
                        alert('Please choose a JPG, PNG or WEBP image.');
                        photoInput.value = '';
                        return;
                    }

                    if (file.size > 5 * 1024 * 1024) {
                        alert('The photo must be 5 MB or smaller.');
                        photoInput.value = '';
                        return;
                    }

                    preview.src = URL.createObjectURL(file);
                    preview.classList.remove('d-none');

                    if (icon) icon.classList.add('d-none');

                    saveBtn.disabled = false;
                });
            }

        })();
    </script>

    <script>
        // Change password validation
        (function () {

            var form = document.getElementById('changePasswordForm');
            var errorBox = document.getElementById('passwordError');

            if (!form) return;

            function showError(msg) {
                errorBox.textContent = msg;
                errorBox.classList.remove('d-none');
            }

            form.addEventListener('submit', function (e) {

                var current = document.getElementById('CurrentPassword').value;
                var next = document.getElementById('NewPassword').value;
                var confirm = document.getElementById('ConfirmPassword').value;

                if (!current || !next || !confirm) {
                    e.preventDefault();
                    return showError('Please fill in all fields.');
                }

                if (next.length < 8) {
                    e.preventDefault();
                    return showError('New password must be at least 8 characters.');
                }

                if (next !== confirm) {
                    e.preventDefault();
                    return showError('New password and confirmation do not match.');
                }

                if (next === current) {
                    e.preventDefault();
                    return showError('New password must be different from the current one.');
                }

                errorBox.classList.add('d-none');
            });

            var modal = document.getElementById('changePasswordModal');

            if (modal) {
                modal.addEventListener('hidden.bs.modal', function () {
                    form.reset();
                    errorBox.classList.add('d-none');
                });
            }

        })();
    </script>
}
