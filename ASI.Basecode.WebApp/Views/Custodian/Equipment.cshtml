@* Location: ASI.Basecode.WebApp/Views/Custodian/Equipment.cshtml *@
@using Microsoft.AspNetCore.Mvc.Rendering
@using SelectListItem = Microsoft.AspNetCore.Mvc.Rendering.SelectListItem
@model IEnumerable<ASI.Basecode.Data.Models.EquipmentItem>
@{
    ViewData["Title"] = "Equipment Item Management";

    var items = (Model ?? new List<ASI.Basecode.Data.Models.EquipmentItem>()).ToList();

    int currentPage = ViewBag.Page is int pg1 ? pg1 : 1;
    int totalPages = ViewBag.TotalPages is int pg2 ? pg2 : 1;
    int pageSize = ViewBag.PageSize is int pg3 ? pg3 : 5;
    int totalItems = ViewBag.TotalItems is int pg4 ? pg4 : items.Count;

    var categoryOptions = (ViewBag.CategoryList as IEnumerable<SelectListItem>) ?? new List<SelectListItem>();
    var editCategoryOptions = (ViewBag.EditCategoryList as IEnumerable<SelectListItem>) ?? new List<SelectListItem>();

    string Na(string value) => string.IsNullOrWhiteSpace(value) ? "N/A" : value;

    (string Text, string Css) StatusBadge(string s) => s switch
    {
        "available" => ("AVAILABLE", "bg-success"),
        "borrowed" => ("BORROWED", "bg-warning text-dark"),
        "maintenance" => ("MAINTENANCE", "bg-secondary"),
        "pending_category" => ("PENDING REVIEW", "bg-info text-dark"),
        "category_rejected" => ("CATEGORY REJECTED", "bg-danger"),
        _ => ((s ?? "").ToUpper(), "bg-warning text-dark")
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" />
    <style>
        .eq-pager .page-link {
            color: var(--d-maroon, #800000);
        }

        .eq-pager .page-item.active .page-link {
            background-color: var(--d-maroon, #800000);
            border-color: var(--d-maroon, #800000);
            color: #fff;
        }

        .eq-pager .page-link:focus {
            box-shadow: 0 0 0 .2rem rgba(128, 0, 0, .2);
        }
    </style>
}

<div class="dash-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="dash-title">Equipment Item Management</h1>
            <p class="dash-subtitle">Register, track physical condition, update locations, and archive inventory items.</p>
        </div>
        <button type="button" class="btn text-white px-4 py-2 fw-bold" style="background-color: var(--d-maroon, #800000);" data-bs-toggle="modal" data-bs-target="#addEquipmentModal">
            <i class="bi bi-plus-lg me-1"></i> Register New Equipment
        </button>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm" style="border-radius: 12px; overflow: hidden;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background-color: #f8f9fa;">
                        <tr class="text-uppercase fs-7 text-muted fw-bold">
                            <th class="ps-4">Item Code</th>
                            <th>Brand & Model</th>
                            <th>Category</th>
                            <th>Serial Number</th>
                            <th>Storage Location</th>
                            <th>Status</th>
                            <th>Condition</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (items.Any())
                        {
                            foreach (var item in items)
                            {
                                var isBorrowed = item.Status == "borrowed";
                                var badge = StatusBadge(item.Status);
                                <tr>
                                    <td class="ps-4 fw-semibold">@item.ItemCode</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            @if (!string.IsNullOrEmpty(item.ImagePath))
                                            {
                                                <img src="@item.ImagePath" alt="@item.BrandModel"
                                                     style="width:44px;height:44px;object-fit:cover;border-radius:6px;" />
                                            }
                                            else
                                            {
                                                <span class="d-inline-flex align-items-center justify-content-center bg-light text-secondary"
                                                      style="width:44px;height:44px;border-radius:6px;">
                                                    <i class="bi bi-image"></i>
                                                </span>
                                            }
                                            <div class="fw-bold text-dark">@item.BrandModel</div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (item.Category != null)
                                        {
                                            @item.Category.CategoryName
                                            @if (!item.Category.IsActive)
                                            {
                                                <span class="text-muted small">(disabled)</span>
                                            }
                                        }
                                        else if (item.Status == "pending_category")
                                        {
                                            <span class="text-muted fst-italic">Other: @item.SuggestedCategory</span>
                                        }
                                        else if (item.Status == "category_rejected")
                                        {
                                            <span class="text-danger small">Rejected: @item.CategoryReviewNote</span>
                                        }
                                        else
                                        {
                                            <span>General</span>
                                        }
                                    </td>
                                    <td><code>@Na(item.SerialNumber)</code></td>
                                    <td>@Na(item.StorageLocation)</td>
                                    <td><span class="badge @badge.Css">@badge.Text</span></td>
                                    <td>
                                        <span class="badge bg-info text-dark">
                                            @item.ConditionRating
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn dash-btn-view" title="Edit Item"
                                                    data-bs-toggle="modal" data-bs-target="#editEquipmentModal"
                                                    data-id="@item.Id"
                                                    data-itemcode="@item.ItemCode"
                                                    data-category="@item.CategoryId"
                                                    data-suggested="@item.SuggestedCategory"
                                                    data-note="@item.CategoryReviewNote"
                                                    data-brand="@item.BrandModel"
                                                    data-serial="@item.SerialNumber"
                                                    data-location="@item.StorageLocation"
                                                    data-condition="@item.ConditionRating"
                                                    data-status="@item.Status"
                                                    data-image="@item.ImagePath">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button type="button" class="btn dash-btn-view text-danger"
                                                    title="@(isBorrowed ? "Currently borrowed - cannot archive" : "Archive Item")"
                                                    data-bs-toggle="modal" data-bs-target="#archiveEquipmentModal"
                                                    data-id="@item.Id"
                                                    data-name="@item.BrandModel (@item.ItemCode)"
                                                    disabled="@isBorrowed">
                                                <i class="bi bi-archive"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-5">
                                    <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                    No equipment items registered in database yet. Click <strong>Register New Equipment</strong> to add one.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalItems > 0)
            {
                var firstShown = (currentPage - 1) * pageSize + 1;
                var lastShown = Math.Min(currentPage * pageSize, totalItems);
                var winStart = Math.Max(1, currentPage - 2);
                var winEnd = Math.Min(totalPages, winStart + 4);
                winStart = Math.Max(1, winEnd - 4);

                <div class="d-flex flex-wrap align-items-center justify-content-between px-4 py-3 border-top gap-2">
                    <span class="text-muted small">Showing @firstShown–@lastShown of @totalItems</span>

                    @if (totalPages > 1)
                    {
                        <nav aria-label="Equipment pages">
                            <ul class="pagination pagination-sm eq-pager mb-0">
                                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" asp-action="Equipment" asp-route-page="@(currentPage - 1)">&laquo;</a>
                                </li>
                                @for (var n = winStart; n <= winEnd; n++)
                                {
                                    <li class="page-item @(n == currentPage ? "active" : "")">
                                        <a class="page-link" asp-action="Equipment" asp-route-page="@n">@n</a>
                                    </li>
                                }
                                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                    <a class="page-link" asp-action="Equipment" asp-route-page="@(currentPage + 1)">&raquo;</a>
                                </li>
                            </ul>
                        </nav>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- Register Equipment Modal -->
<div class="modal fade" id="addEquipmentModal" tabindex="-1" aria-labelledby="addEquipmentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
            <div class="modal-header text-white px-4 py-3" style="background-color: var(--d-maroon, #800000);">
                <h5 class="modal-title fw-bold" id="addEquipmentModalLabel">
                    <i class="bi bi-box-seam me-2"></i>Register New Equipment Item
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Custodian" asp-action="AddEquipment" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="dash-stat-label mb-1">ITEM CODE / ASSET TAG *</label>
                            <input type="text" name="ItemCode" class="form-control dash-search-input" placeholder="e.g. EQ-CAM-005" maxlength="50" required />
                        </div>

                        <div class="col-md-6">
                            <label class="dash-stat-label mb-1">CATEGORY *</label>
                            <select name="CategoryId" id="CategoryId" class="form-select dash-search-input" required>
                                <option value="" disabled selected>Select Category</option>
                                @foreach (var c in categoryOptions)
                                {
                                    <option value="@c.Value">@c.Text</option>
                                }
                                <option value="0">Other (needs admin approval)</option>
                            </select>
                        </div>

                        <div class="col-12 d-none" id="suggestedWrap">
                            <label class="dash-stat-label mb-1">WHAT CATEGORY DOES THIS ITEM NEED? *</label>
                            <input type="text" name="SuggestedCategory" id="suggestedInput" class="form-control dash-search-input"
                                   placeholder="e.g. Sewing & Garments" maxlength="100" />
                            <div class="form-text">An admin will review this and create the category. The item stays hidden from students until then.</div>
                        </div>

                        <div class="col-md-6">
                            <label class="dash-stat-label mb-1">BRAND & MODEL NAME *</label>
                            <input type="text" name="BrandModel" class="form-control dash-search-input" placeholder="e.g. Canon EOS 2000D" maxlength="100" required />
                        </div>

                        <div class="col-md-6">
                            <label class="dash-stat-label mb-1">SERIAL NUMBER</label>
                            <input type="text" name="SerialNumber" class="form-control dash-search-input" placeholder="Leave blank if not applicable" maxlength="100" />
                        </div>

                        <div class="col-md-6">
                            <label class="dash-stat-label mb-1">STORAGE LOCATION</label>
                            <input type="text" name="StorageLocation" class="form-control dash-search-input" placeholder="e.g. Cabinet A - Shelf 2 (optional)" maxlength="100" />
                        </div>

                        <div class="col-md-6">
                            <label class="dash-stat-label mb-1">INITIAL PHYSICAL CONDITION *</label>
                            <select name="ConditionRating" class="form-select dash-search-input" required>
                                <option value="excellent">Excellent / Brand New</option>
                                <option value="good" selected>Good Condition</option>
                                <option value="minor_wear">Minor Wear & Tear</option>
                                <option value="needs_maintenance">Needs Maintenance</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="dash-stat-label mb-1">EQUIPMENT PHOTO (OPTIONAL)</label>
                            <input type="file" name="photo" id="photoInput" class="form-control dash-search-input"
                                   accept="image/png,image/jpeg,image/webp" />
                            <div class="form-text">JPG, PNG or WEBP, up to 5 MB.</div>
                            <img id="photoPreview" alt="Photo preview" class="mt-2 d-none"
                                 style="max-height:140px;max-width:100%;border-radius:8px;object-fit:cover;" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light px-4 py-3">
                    <button type="button" class="btn btn-outline-secondary px-4 fw-semibold" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn text-white px-4 fw-bold" style="background-color: var(--d-maroon, #800000);">
                        <i class="bi bi-floppy me-1"></i> Save Asset Record
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Equipment Modal -->
<div class="modal fade" id="editEquipmentModal" tabindex="-1" aria-labelledby="editEquipmentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
            <div class="modal-header text-white px-4 py-3" style="background-color: var(--d-maroon, #800000);">
                <h5 class="modal-title fw-bold" id="editEquipmentModalLabel">
                    <i class="bi bi-pencil-square me-2"></i>Edit Equipment Item
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Custodian" asp-action="EditEquipment" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="editId" />
                <input type="hidden" name="page" value="@currentPage" />

                <div class="modal-body p-4">
                    <div class="alert alert-danger d-none" id="editRejectNote"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="dash-stat-label mb-1">ITEM CODE / ASSET TAG *</label>
                            <input type="text" name="ItemCode" id="editItemCode" class="form-control dash-search-input" maxlength="50" required />
                        </div>

                        <div class="col-md-6">
                            <label class="dash-stat-label mb-1">CATEGORY *</label>
                            <select name="CategoryId" id="editCategoryId" class="form-select dash-search-input" required>
                                @foreach (var c in editCategoryOptions)
                                {
                                    <option value="@c.Value">@c.Text</option>
                                }
                                <option value="0">Other (needs admin approval)</option>
                            </select>
                        </div>

                        <div class="col-12 d-none" id="editSuggestedWrap">
                            <label class="dash-stat-label mb-1">WHAT CATEGORY DOES THIS ITEM NEED? *</label>
                            <input type="text" name="SuggestedCategory" id="editSuggestedInput" class="form-control dash-search-input"
                                   placeholder="e.g. Sewing & Garments" maxlength="100" />
                            <div class="form-text">An admin will review this and create the category.</div>
                        </div>

                        <div class="col-md-6">
                            <label class="dash-stat-label mb-1">BRAND & MODEL NAME *</label>
                            <input type="text" name="BrandModel" id="editBrandModel" class="form-control dash-search-input" maxlength="100" required />
                        </div>

                        <div class="col-md-6">
                            <label class="dash-stat-label mb-1">SERIAL NUMBER</label>
                            <input type="text" name="SerialNumber" id="editSerialNumber" class="form-control dash-search-input" placeholder="Leave blank if not applicable" maxlength="100" />
                        </div>

                        <div class="col-md-6">
                            <label class="dash-stat-label mb-1">STORAGE LOCATION</label>
                            <input type="text" name="StorageLocation" id="editStorageLocation" class="form-control dash-search-input" placeholder="Optional" maxlength="100" />
                        </div>

                        <div class="col-md-6">
                            <label class="dash-stat-label mb-1">PHYSICAL CONDITION *</label>
                            <select name="ConditionRating" id="editCondition" class="form-select dash-search-input" required>
                                <option value="excellent">Excellent / Brand New</option>
                                <option value="good">Good Condition</option>
                                <option value="minor_wear">Minor Wear & Tear</option>
                                <option value="needs_maintenance">Needs Maintenance</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="dash-stat-label mb-1">AVAILABILITY</label>
                            <select name="Status" id="editStatus" class="form-select dash-search-input">
                                <option value="available">Available</option>
                                <option value="maintenance">Under maintenance (hidden from students)</option>
                            </select>
                            <div class="form-text d-none" id="editStatusNote"></div>
                        </div>

                        <div class="col-md-6">
                            <label class="dash-stat-label mb-1">REPLACE PHOTO (OPTIONAL)</label>
                            <input type="file" name="photo" id="editPhotoInput" class="form-control dash-search-input"
                                   accept="image/png,image/jpeg,image/webp" />
                            <div class="form-text">JPG, PNG or WEBP, up to 5 MB. Leave empty to keep the current photo.</div>
                        </div>

                        <div class="col-12">
                            <img id="editPhotoPreview" alt="Equipment photo" class="d-none"
                                 style="max-height:140px;max-width:100%;border-radius:8px;object-fit:cover;" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light px-4 py-3">
                    <button type="button" class="btn btn-outline-secondary px-4 fw-semibold" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn text-white px-4 fw-bold" style="background-color: var(--d-maroon, #800000);">
                        <i class="bi bi-floppy me-1"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Archive Confirmation Modal -->
<div class="modal fade" id="archiveEquipmentModal" tabindex="-1" aria-labelledby="archiveEquipmentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
            <div class="modal-header bg-danger text-white px-4 py-3">
                <h5 class="modal-title fw-bold" id="archiveEquipmentModalLabel">
                    <i class="bi bi-archive me-2"></i>Archive Equipment
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Custodian" asp-action="ArchiveEquipment" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="archiveId" />
                <input type="hidden" name="page" value="@currentPage" />

                <div class="modal-body p-4">
                    <p class="mb-2">Archive <strong id="archiveName"></strong>?</p>
                    <p class="text-muted small mb-0">
                        It will be removed from the inventory list and from the student catalog.
                        Its borrowing history is kept.
                    </p>
                </div>
                <div class="modal-footer bg-light px-4 py-3">
                    <button type="button" class="btn btn-outline-secondary px-4 fw-semibold" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger px-4 fw-bold">
                        <i class="bi bi-archive me-1"></i> Archive
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function() {
            var MAX_BYTES = 5 * 1024 * 1024;

            // Photo picker with 5 MB check + live preview
            function wirePhoto(inputId, previewId) {
                var input = document.getElementById(inputId);
                var preview = document.getElementById(previewId);
                if (!input) return;

                input.addEventListener('change', function() {
                    var file = input.files && input.files[0];
                    if (!file) { preview.classList.add('d-none'); return; }

                    if (file.size > MAX_BYTES) {
                        alert('The photo must be 5 MB or smaller.');
                        input.value = '';
                        preview.classList.add('d-none');
                        return;
                    }
                    preview.src = URL.createObjectURL(file);
                    preview.classList.remove('d-none');
                });
            }
            wirePhoto('photoInput', 'photoPreview');
            wirePhoto('editPhotoInput', 'editPhotoPreview');

            // "Other" category: show and require the suggested-name field (category value 0 = Other)
            function wireOther(selectId, wrapId, inputId) {
                var sel = document.getElementById(selectId);
                var wrap = document.getElementById(wrapId);
                var input = document.getElementById(inputId);

                function sync() {
                    var other = sel.value === '0';
                    wrap.classList.toggle('d-none', !other);
                    input.required = other;
                    if (!other) { input.value = ''; }
                }
                sel.addEventListener('change', sync);
                sync();
                return sync;
            }
            wireOther('CategoryId', 'suggestedWrap', 'suggestedInput');
            var syncEdit = wireOther('editCategoryId', 'editSuggestedWrap', 'editSuggestedInput');

            // Fill the Edit modal from the clicked row's data-* attributes
            var editModal = document.getElementById('editEquipmentModal');
            editModal.addEventListener('show.bs.modal', function(ev) {
                var b = ev.relatedTarget;
                if (!b) return;

                var awaiting = b.dataset.status === 'pending_category' || b.dataset.status === 'category_rejected';
                var hasCategory = !!b.dataset.category;

                document.getElementById('editId').value = b.dataset.id || '';
                document.getElementById('editItemCode').value = b.dataset.itemcode || '';
                document.getElementById('editBrandModel').value = b.dataset.brand || '';
                document.getElementById('editSerialNumber').value = b.dataset.serial || '';
                document.getElementById('editStorageLocation').value = b.dataset.location || '';
                document.getElementById('editCondition').value = b.dataset.condition || 'good';

                // "Other" is only available while the item has no category yet
                var catSel = document.getElementById('editCategoryId');
                var otherOpt = catSel.querySelector('option[value="0"]');
                otherOpt.hidden = hasCategory;
                otherOpt.disabled = hasCategory;
                catSel.value = hasCategory ? b.dataset.category : '0';
                syncEdit();
                if (!hasCategory) {
                    document.getElementById('editSuggestedInput').value = b.dataset.suggested || '';
                }

                var rej = document.getElementById('editRejectNote');
                if (b.dataset.status === 'category_rejected') {
                    rej.textContent = 'The admin did not approve the suggested category: ' +
                        (b.dataset.note || 'no reason given') +
                        '. Choose an existing category or suggest another one.';
                    rej.classList.remove('d-none');
                } else {
                    rej.classList.add('d-none');
                }

                var status = document.getElementById('editStatus');
                var note = document.getElementById('editStatusNote');
                var borrowed = b.dataset.status === 'borrowed';
                status.value = b.dataset.status === 'maintenance' ? 'maintenance' : 'available';
                status.disabled = borrowed || awaiting;
                if (borrowed) {
                    note.textContent = "This item is currently borrowed, so its availability can't be changed.";
                } else if (awaiting) {
                    note.textContent = 'Availability is set automatically once the category is approved.';
                }
                note.classList.toggle('d-none', !(borrowed || awaiting));

                document.getElementById('editPhotoInput').value = '';
                var preview = document.getElementById('editPhotoPreview');
                if (b.dataset.image) {
                    preview.src = b.dataset.image;
                    preview.classList.remove('d-none');
                } else {
                    preview.classList.add('d-none');
                    preview.removeAttribute('src');
                }
            });

            // Fill the Archive confirmation modal
            var archiveModal = document.getElementById('archiveEquipmentModal');
            archiveModal.addEventListener('show.bs.modal', function(ev) {
                var b = ev.relatedTarget;
                if (!b) return;
                document.getElementById('archiveId').value = b.dataset.id || '';
                document.getElementById('archiveName').textContent = b.dataset.name || 'this item';
            });
        })();
    </script>
}