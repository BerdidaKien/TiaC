@* Location: ASI.Basecode.WebApp/Views/Custodian/Index.cshtml *@
@using ASI.Basecode.Data.Models
@model ASI.Basecode.Services.ServiceModels.DashboardViewModel
@{
    ViewData["Title"] = "Custodian Dashboard";

    string IconFor(string categoryCode) => (categoryCode ?? "") switch
    {
        "AV-MEDIA" => "bi-camera",
        "IT-TECH" => "bi-laptop",
        "EVENT-SUP" => "bi-megaphone",
        "LAB-SCI" => "bi-eyedropper",
        "SPORTS-REC" => "bi-trophy",
        "GEN-TOOLS" => "bi-tools",
        _ => "bi-box-seam"
    };

    var pageItems = ViewBag.PagedItems as List<EquipmentItem> ?? new List<EquipmentItem>();
    int page = (int)(ViewBag.Page ?? 1);
    int pageSize = (int)(ViewBag.PageSize ?? 4);
    int totalPages = (int)(ViewBag.TotalPages ?? 1);
    int totalItems = (int)(ViewBag.TotalItems ?? 0);

    int firstShown = totalItems == 0 ? 0 : (page - 1) * pageSize + 1;
    int lastShown = Math.Min(page * pageSize, totalItems);

    string PageLink(int p) => Url.Action("Index", "Custodian", new
    {
        search = Model.Search,
        categoryId = Model.CategoryId,
        status = Model.Status,
        page = p
    });

    // Page numbers to show; 0 means "..."
    var window = new List<int>();
    int prevP = 0;
    foreach (var p in new SortedSet<int> { 1, totalPages, page - 1, page, page + 1 }.Where(p => p >= 1 && p <= totalPages))
    {
        if (prevP != 0 && p - prevP > 1) { window.Add(0); }
        window.Add(p);
        prevP = p;
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <style>
        /* Compact equipment card: photo is always visible */
        .cd-card {
            padding: .75rem;
        }

        .cd-media {
            aspect-ratio: 4 / 3; /* every box is the same shape, whatever the photo */
            margin-bottom: .6rem;
            border-radius: .5rem;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--d-circle); /* shows in the empty space around the photo */
        }

            .cd-media img {
                max-width: 100%;
                max-height: 100%;
                width: 100%;
                height: 100%;
                object-fit: contain; /* the whole photo is visible, never cropped */
                object-position: center;
            }

        .cd-title {
            font-size: 1rem;
            line-height: 1.25;
        }

        .cd-meta {
            font-size: .78rem;
            line-height: 1.45;
        }
    </style>
}

<div class="dash-header mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
    <div>
        <h1 class="dash dash-name m-0">Custodian Dashboard</h1>
        <p class="dash-sub">Manage inventory stock, track active borrowings, and oversee reservations.</p>
    </div>
    <partial name="_UserBadge" />
</div>

<!-- Metric cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="dash-card res-card">
            <div class="res-card-icon bg-danger-subtle text-danger"><i class="bi bi-box-seam"></i></div>
            <div>
                <div class="dash-stat-label mb-0">Total Equipment</div>
                <div class="dash-stat-count">@Model.TotalEquipment</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="dash-card res-card">
            <div class="res-card-icon bg-success-subtle text-success"><i class="bi bi-check-circle"></i></div>
            <div>
                <div class="dash-stat-label mb-0">Available Items</div>
                <div class="dash-stat-count">@Model.AvailableItems</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="dash-card res-card">
            <div class="res-card-icon bg-warning-subtle text-warning"><i class="bi bi-box-arrow-up-right"></i></div>
            <div>
                <div class="dash-stat-label mb-0">Currently Borrowed</div>
                <div class="dash-stat-count">@Model.CurrentlyBorrowed</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <a asp-controller="Custodian" asp-action="Reservations" class="text-decoration-none d-block h-100">
            <div class="dash-card res-card">
                <div class="res-card-icon bg-primary-subtle text-primary"><i class="bi bi-hourglass-split"></i></div>
                <div>
                    <div class="dash-stat-label mb-0">Pending Requests</div>
                    <div class="dash-stat-count">@Model.PendingRequests</div>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Filter & Search Bar -->
<form method="get" asp-controller="Custodian" asp-action="Index" class="dash-card mb-4">
    <div class="row g-2 align-items-center">
        <div class="col-md-5">
            <input type="text" name="search" value="@Model.Search" class="form-control dash-search-input"
                   placeholder="Search by item code, brand/model, or serial number..." />
        </div>
        <div class="col-md-3">
            <select name="categoryId" class="form-select dash-search-input">
                <option value="">All Categories</option>
                @foreach (var c in Model.Categories)
                {
                    <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.CategoryName</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="status" class="form-select dash-search-input">
                <option value="">All Status</option>
                <option value="available" selected="@(Model.Status == "available")">Available</option>
                <option value="borrowed" selected="@(Model.Status == "borrowed")">Currently Borrowed</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn dash-btn-reserve w-100">Search</button>
        </div>
    </div>
</form>

<!-- Equipment Inventory Grid -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="dash fs-3 fw-bold m-0">Equipment Overview</h3>
    <span class="text-muted small">Showing @firstShown&ndash;@lastShown of @totalItems items</span>
</div>

@if (pageItems.Any())
{
    <div class="row g-3">
        @foreach (var item in pageItems)
        {
            var isBorrowed = Model.BorrowedItemIds.Contains(item.Id);
            var hasPhoto = !string.IsNullOrEmpty(item.ImagePath);
            <div class="col-sm-6 col-xl-3">
                <div class="dash-card cd-card h-100">
                    <div>
                        <div class="cd-media">
                            @if (hasPhoto)
                            {
                                <img src="@item.ImagePath" alt="@item.BrandModel" loading="lazy"
                                     onerror="this.style.display='none'; this.nextElementSibling.classList.remove('d-none');" />
                            }
                            <i class="bi @IconFor(item.Category?.CategoryCode) fs-1 text-secondary @(hasPhoto ? "d-none" : "")"></i>
                        </div>
                        <h4 class="dash cd-title fw-bold mb-1">@item.BrandModel</h4>
                        <div class="cd-meta text-muted">
                            <div>Code: @item.ItemCode</div>
                            <div>Category: @(item.Category?.CategoryName ?? "General")</div>
                            <div>Location: @(string.IsNullOrWhiteSpace(item.StorageLocation) ? "-" : item.StorageLocation)</div>
                            <div>Condition: <span class="text-capitalize">@item.ConditionRating?.Replace("_", " ")</span></div>
                        </div>
                    </div>
                    <div class="mt-2 d-flex align-items-center justify-content-between gap-2">
                        @if (isBorrowed)
                        {
                            <span class="dash-pill is-borrowed">Currently Borrowed</span>
                        }
                        else
                        {
                            <span class="dash-pill is-available">@(item.Status == "available" ? "Available" : item.Status)</span>
                        }
                        <a asp-controller="Custodian" asp-action="Equipment" class="btn btn-sm btn-outline-danger fw-bold">Manage</a>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (totalPages > 1)
    {
        <nav aria-label="Equipment pages" class="mt-4 d-flex justify-content-center">
            <ul class="pagination pagination-sm dash-pagination mb-0">
                <li class="page-item @(page <= 1 ? "disabled" : "")">
                    <a class="page-link" href="@PageLink(page - 1)" aria-label="Previous"><i class="bi bi-chevron-left"></i></a>
                </li>
                @foreach (var p in window)
                {
                    if (p == 0)
                    {
                        <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                    }
                    else
                    {
                        <li class="page-item @(p == page ? "active" : "")"><a class="page-link" href="@PageLink(p)">@p</a></li>
                    }
                }
                <li class="page-item @(page >= totalPages ? "disabled" : "")">
                    <a class="page-link" href="@PageLink(page + 1)" aria-label="Next"><i class="bi bi-chevron-right"></i></a>
                </li>
            </ul>
        </nav>
    }
}
else
{
    <div class="dash-card text-center text-muted py-5">
        <i class="bi bi-inbox fs-2 d-block mb-2"></i>
        No equipment found. Try different filters, or register items on the Equipment page.
    </div>
}