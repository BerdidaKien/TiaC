@using ASI.Basecode.Services.ServiceModels
@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";

    string ShortDate(DateTime? d) => d.HasValue ? d.Value.ToString("MMM d, yyyy") : "-";

    (string Text, string Css, string Icon) ReservationBadge(string s) => s switch
    {
        "pending" => ("Pending", "bg-warning-subtle text-warning-emphasis", "bi-clock"),
        "approved" => ("Approved", "bg-success-subtle text-success-emphasis", "bi-check-lg"),
        "borrowed" => ("Borrowed", "bg-primary-subtle text-primary-emphasis", "bi-box-arrow-up-right"),
        "overdue" => ("Overdue", "bg-danger text-white", "bi-exclamation-triangle"),
        "completed" => ("Completed", "bg-secondary-subtle text-secondary-emphasis", "bi-check2-all"),
        "rejected" => ("Rejected", "bg-danger-subtle text-danger-emphasis", "bi-x-lg"),
        "cancelled" => ("Cancelled", "bg-secondary-subtle text-secondary-emphasis", "bi-slash-circle"),
        _ => (s ?? "-", "bg-light text-dark", "bi-dot")
    };

    string ItemStatusCss(string s) => s switch
    {
        "available" => "bg-success-subtle text-success-emphasis",
        "borrowed" => "bg-warning-subtle text-warning-emphasis",
        "maintenance" => "bg-danger-subtle text-danger-emphasis",
        _ => "bg-light text-dark"
    };

    string RoleCss(string r) => r == "Admin" ? "bg-dark" : r == "Custodian" ? "bg-warning text-dark" : "bg-danger";
    string RoleText(string r) => r == "User" ? "Borrower" : r;
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <style>
        .dash-card.stat-compact {
            padding: .6rem .9rem;
        }

        .stat-compact .stat-icon {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            flex-shrink: 0;
        }

        .stat-compact .dash-stat-label {
            font-size: .75rem;
        }

        .stat-compact .dash-stat-count {
            font-size: 1.5rem;
            line-height: 1.1;
        }

        .stat-compact .stat-sub {
            font-size: .72rem;
        }

        a:hover > .stat-compact {
            box-shadow: 0 0 0 1px #800000 inset;
        }
    </style>
}

<div class="dash-header mb-4">
    <h1 class="dash dash-name m-0">Dashboard</h1>
    <p class="dash-sub">Overview of your inventory and reservation management system.</p>
</div>

<!-- 1. Compact metric cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <a asp-controller="Admin" asp-action="Reservations" class="text-decoration-none">
            <div class="dash-card stat-compact d-flex align-items-center gap-3">
                <div class="stat-icon bg-danger-subtle text-danger"><i class="bi bi-calendar-event"></i></div>
                <div>
                    <div class="dash-stat-label">Total Reservations</div>
                    <div class="dash-stat-count">@Model.TotalReservations</div>
                    <div class="stat-sub text-muted">@Model.PendingReservations pending</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-xl-3">
        <a asp-controller="Admin" asp-action="Reports" class="text-decoration-none">
            <div class="dash-card stat-compact d-flex align-items-center gap-3">
                <div class="stat-icon bg-primary-subtle text-primary"><i class="bi bi-box-seam"></i></div>
                <div>
                    <div class="dash-stat-label">Total Items</div>
                    <div class="dash-stat-count">@Model.TotalItems</div>
                    <div class="stat-sub text-muted">@Model.BorrowedItems borrowed &middot; @Model.MaintenanceItems maintenance</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-xl-3">
        <a asp-controller="Admin" asp-action="Users" class="text-decoration-none">
            <div class="dash-card stat-compact d-flex align-items-center gap-3">
                <div class="stat-icon bg-warning-subtle text-warning"><i class="bi bi-people"></i></div>
                <div>
                    <div class="dash-stat-label">Total Users</div>
                    <div class="dash-stat-count">@Model.TotalUsers</div>
                    <div class="stat-sub text-muted">@Model.ActiveUsers active</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-xl-3">
        <a asp-controller="Admin" asp-action="Reports" asp-route-status="available" class="text-decoration-none">
            <div class="dash-card stat-compact d-flex align-items-center gap-3">
                <div class="stat-icon bg-success-subtle text-success"><i class="bi bi-check-circle"></i></div>
                <div>
                    <div class="dash-stat-label">Available Items</div>
                    <div class="dash-stat-count">@Model.AvailableItems</div>
                    <div class="stat-sub text-muted">@Model.AvailablePercent% of total items</div>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- 2. Recent users and items -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="dash-card p-3 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h6 class="dash fw-bold m-0"><i class="bi bi-person-plus me-1"></i> Recent Added Users</h6>
                    <small class="text-muted">Latest created accounts.</small>
                </div>
                <a asp-controller="Admin" asp-action="Users" class="btn btn-sm btn-outline-secondary">View All <i class="bi bi-chevron-right"></i></a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light">
                        <tr><th>#</th><th>Name</th><th>Role</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.RecentUsers.Count; i++)
                        {
                            var u = Model.RecentUsers[i];
                            <tr>
                                <td>@(i + 1)</td>
                                <td>
                                    <div class="fw-bold">@u.Name</div>
                                    <div class="text-muted">@u.UserCode</div>
                                </td>
                                <td><span class="badge @RoleCss(u.Role)">@RoleText(u.Role)</span></td>
                                <td>
                                    @if (u.IsActive)
                                    {
                                        <span class="text-success fw-bold"><i class="bi bi-circle-fill me-1" style="font-size:.5rem;"></i>Active</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger fw-bold"><i class="bi bi-circle-fill me-1" style="font-size:.5rem;"></i>Inactive</span>
                                    }
                                </td>
                            </tr>
                        }
                        @if (!Model.RecentUsers.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted py-3">No users yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="dash-card p-3 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h6 class="dash fw-bold m-0"><i class="bi bi-box me-1"></i> Recent Added Items</h6>
                    <small class="text-muted">Latest added inventory items.</small>
                </div>
                <a asp-controller="Admin" asp-action="Reports" class="btn btn-sm btn-outline-secondary">View All <i class="bi bi-chevron-right"></i></a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light">
                        <tr><th>#</th><th>Item Name</th><th>Category</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.RecentItems.Count; i++)
                        {
                            var it = Model.RecentItems[i];
                            <tr>
                                <td>@(i + 1)</td>
                                <td>
                                    <div class="fw-bold">@it.Name</div>
                                    <div class="text-muted">@it.ItemCode</div>
                                </td>
                                <td>@it.CategoryName</td>
                                <td><span class="badge @ItemStatusCss(it.Status)">@ItemLabels.Status(it.Status)</span></td>
                            </tr>
                        }
                        @if (!Model.RecentItems.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted py-3">No items yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- 3. Recent reservations -->
<div class="dash-card p-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h6 class="dash fw-bold m-0"><i class="bi bi-calendar-check me-1"></i> Recent Reservations</h6>
            <small class="text-muted">Latest reservation requests.</small>
        </div>
        <a asp-controller="Admin" asp-action="Reservations" class="btn btn-sm btn-outline-secondary">View All <i class="bi bi-chevron-right"></i></a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small">
            <thead class="table-light">
                <tr>
                    <th>Reservation ID</th>
                    <th>Student / Employee</th>
                    <th>Item</th>
                    <th>Reservation Date</th>
                    <th>Status</th>
                    <th class="text-end">View</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.RecentReservations)
                {
                    var b = ReservationBadge(r.Status);
                    <tr>
                        <td class="fw-semibold">@r.Code</td>
                        <td>
                            <div class="fw-bold">@r.BorrowerName</div>
                            <div class="text-muted">@r.BorrowerCode</div>
                        </td>
                        <td>
                            <div>@r.ItemName</div>
                            <div class="text-muted">@r.ItemCode</div>
                        </td>
                        <td>@ShortDate(r.ReservationDate)</td>
                        <td><span class="badge @b.Css"><i class="bi @b.Icon me-1"></i>@b.Text</span></td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" title="View in Reservations"
                               asp-controller="Admin" asp-action="Reservations" asp-route-search="@r.Code">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.RecentReservations.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-3">No reservations yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>