@using ASI.Basecode.Services.ServiceModels
@model ItemReportsPageViewModel
@{
    Layout = null;
    var f = Model.Filter;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Item Report</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        body { padding: 24px; font-size: 12px; }
        @@media print { .d-print-none { display: none !important; } }
    </style>
</head>
<body>
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h3 class="mb-0">TiaC - Item Report</h3>
            <div class="text-muted">Generated @DateTime.Now.ToString("MMM d, yyyy h:mm tt")</div>
            <div class="text-muted">
                Filters:
                @(string.IsNullOrWhiteSpace(f.Search) ? "" : $"keyword '{f.Search}'; ")
                @(string.IsNullOrWhiteSpace(f.Status) ? "" : $"status: {ItemLabels.Status(f.Status)}; ")
                @(string.IsNullOrWhiteSpace(f.Condition) ? "" : $"condition: {ItemLabels.Condition(f.Condition)}; ")
                @(f.CategoryId.HasValue ? "category selected" : "")
                @if (string.IsNullOrWhiteSpace(f.Search) && string.IsNullOrWhiteSpace(f.Status) && string.IsNullOrWhiteSpace(f.Condition) && !f.CategoryId.HasValue)
                {
                    <text>none (all items)</text>
                }
            </div>
        </div>
        <button class="btn btn-danger d-print-none" onclick="window.print()">Print / Save as PDF</button>
    </div>

    <div class="row mb-3">
        <div class="col"><strong>Total items:</strong> @Model.TotalItems</div>
        <div class="col"><strong>Available:</strong> @Model.AvailableCount</div>
        <div class="col"><strong>Borrowed:</strong> @Model.BorrowedCount</div>
        <div class="col"><strong>For maintenance:</strong> @Model.MaintenanceCount</div>
    </div>

    <table class="table table-bordered table-sm">
        <thead class="table-light">
            <tr>
                <th>Item ID</th><th>Item Name</th><th>Category</th><th>Borrowed By</th>
                <th>Borrow Date</th><th>Expected Return</th><th>Status</th><th>Condition</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr>
                    <td>@r.ItemCode</td>
                    <td>@r.ItemName</td>
                    <td>@r.CategoryName</td>
                    <td>@(r.BorrowerName == null ? "-" : $"{r.BorrowerName} ({r.BorrowerCode})")</td>
                    <td>@(r.BorrowDate.HasValue ? r.BorrowDate.Value.ToString("MMM d, yyyy") : "-")</td>
                    <td>@(r.ExpectedReturn.HasValue ? r.ExpectedReturn.Value.ToString("MMM d, yyyy") : "-")@(r.IsOverdue ? " (overdue)" : "")</td>
                    <td>@ItemLabels.Status(r.Status)</td>
                    <td>@ItemLabels.Condition(r.Condition)</td>
                </tr>
            }
            @if (!Model.Rows.Any())
            {
                <tr><td colspan="8" class="text-center text-muted">No items.</td></tr>
            }
        </tbody>
    </table>

    <script>window.onload = function () { window.print(); };</script>
</body>
</html>