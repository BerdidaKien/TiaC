@model ASI.Basecode.Services.ServiceModels.UserManagementViewModel
@{
    ViewData["Title"] = "User Management";

    (string Text, string Css) StatusBadge(string s) => s switch
    {
        "active" => ("Active", "bg-success-subtle text-success-emphasis"),
        "inactive" => ("Inactive", "bg-warning-subtle text-warning-emphasis"),
        "disabled" => ("Disabled", "bg-danger-subtle text-danger-emphasis"),
        _ => (s ?? "-", "bg-light text-dark")
    };

    string RoleCss(string r) => r == "Admin" ? "bg-dark" : r == "Custodian" ? "bg-warning text-dark" : "bg-danger";
    string RoleText(string r) => r == "User" || r == "Student" ? "Borrower" : r;
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dash-header mb-4">
    <h1 class="dash dash-name m-0">User Management</h1>
    <p class="dash-sub">Create and manage user accounts, update their status, and review information change requests.</p>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="dash-card">
            <div class="dash-stat-label">Total Users</div>
            <div class="dash-stat-count">@Model.TotalUsers</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="dash-card">
            <div class="dash-stat-label">Borrowers</div>
            <div class="dash-stat-count">@Model.TotalBorrowers</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="dash-card">
            <div class="dash-stat-label">Custodians</div>
            <div class="dash-stat-count">@Model.TotalCustodians</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="dash-card">
            <div class="dash-stat-label">Administrators</div>
            <div class="dash-stat-count">@Model.TotalAdministrators</div>
        </div>
    </div>
</div>

<!-- Search & Filter Bar -->
<div class="dash-card mb-4">
    <form method="get" asp-controller="Admin" asp-action="Users" class="row g-2 align-items-center">
        <div class="col-md-4">
            <input type="text" name="search" value="@Model.SearchTerm" class="form-control dash-search-input" placeholder="Search by name, email, or ID..." />
        </div>
        <div class="col-md-2">
            <select name="role" class="form-select dash-search-input">
                <option value="">All Roles</option>
                <option value="User" selected="@(Model.SelectedRole == "User")">Borrower</option>
                <option value="Custodian" selected="@(Model.SelectedRole == "Custodian")">Custodian</option>
                <option value="Admin" selected="@(Model.SelectedRole == "Admin")">Administrator</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="status" class="form-select dash-search-input">
                <option value="">All Status</option>
                <option value="active" selected="@(Model.SelectedStatus == "active")">Active</option>
                <option value="inactive" selected="@(Model.SelectedStatus == "inactive")">Inactive</option>
                <option value="disabled" selected="@(Model.SelectedStatus == "disabled")">Disabled</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-outline-secondary w-100">Search</button>
        </div>
        <div class="col-md-2">
            <a asp-controller="Admin" asp-action="AddUsers" class="btn dash-btn-reserve w-100 text-center text-white text-decoration-none">
                <i class="bi bi-person-plus me-1"></i> Add User
            </a>
        </div>
    </form>
    <div class="mt-2">
        <a asp-controller="Admin" asp-action="Users" class="small text-muted"><i class="bi bi-arrow-counterclockwise me-1"></i>Reset filters</a>
    </div>
</div>

<!-- Table Data -->
<div class="dash-card p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">User</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Date Created</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    var badge = StatusBadge(user.Status);
                    <tr class="@(user.Status == "disabled" ? "text-muted" : "")">
                        <td class="ps-4">
                            <div class="d-flex align-items-center">
                                <div class="avatar-circle me-2 bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center" style="width:36px; height:36px; font-weight:bold;">
                                    @user.Initials
                                </div>
                                <div>
                                    <div class="fw-bold">@user.FullName</div>
                                    <div class="text-muted small">@user.UserId</div>
                                </div>
                            </div>
                        </td>
                        <td>@user.Email</td>
                        <td><span class="badge @RoleCss(user.Role)">@RoleText(user.Role)</span></td>
                        <td><span class="badge @badge.Css">@badge.Text</span></td>
                        <td>@user.DateCreated.ToString("MMM dd, yyyy")</td>
                        <td class="text-end pe-4">
                            <a asp-controller="Admin" asp-action="EditUser" asp-route-id="@user.Id"
                               class="btn btn-sm btn-outline-secondary" title="Edit user">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Users.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-5">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            No users match your filters.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>