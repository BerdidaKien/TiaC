@using System.Linq
@inject ASI.Basecode.Services.Interfaces.IInfoRequestService InfoRequests
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    bool IsActive(string controller, params string[] actions) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) &&
        (actions == null || actions.Length == 0 ||
         actions.Any(a => string.Equals(currentAction, a, StringComparison.OrdinalIgnoreCase)));

    var pendingRequests = ViewBag.LoginView == true ? 0 : InfoRequests.PendingCount();
}

@if (ViewBag.LoginView != true)
{
    <nav class="side-nav" aria-label="Admin navigation">
        <a class="side-nav__brand" asp-controller="Admin" asp-action="Index" aria-label="Go to dashboard">
            TiaC
        </a>

        <ul class="side-nav__links">
            <li>
                <a class="side-nav__link @(IsActive("Admin", "Index") ? "is-active" : "")"
                   asp-controller="Admin" asp-action="Index">
                    <i class="fa-solid fa-house"></i>
                    <span class="side-nav__text">Dashboard</span>
                </a>
            </li>
            <li>
                <a class="side-nav__link @(IsActive("Admin", "Users", "AddUsers", "EditUser") ? "is-active" : "")"
                   asp-controller="Admin" asp-action="Users">
                    <i class="fa-solid fa-users"></i>
                    <span class="side-nav__text">Users</span>
                </a>
            </li>
            <li>
                <a class="side-nav__link @(IsActive("Admin", "InfoRequests", "ReviewInfoRequest") ? "is-active" : "")"
                   asp-controller="Admin" asp-action="InfoRequests">
                    <i class="fa-solid fa-file-pen"></i>
                    <span class="side-nav__text">Info Requests</span>
                    @if (pendingRequests > 0)
                    {
                        <span class="badge bg-warning text-dark ms-auto">@pendingRequests</span>
                    }
                </a>
            </li>
            <li>
                <a class="side-nav__link @(IsActive("Admin", "Categories") ? "is-active" : "")"
                   asp-controller="Admin" asp-action="Categories">
                    <i class="fa-solid fa-tags"></i>
                    <span class="side-nav__text">Categories</span>
                </a>
            </li>
            <li>
                <a class="side-nav__link @(IsActive("Admin", "Reservations") ? "is-active" : "")"
                   asp-controller="Admin" asp-action="Reservations">
                    <i class="fa-solid fa-calendar"></i>
                    <span class="side-nav__text">Reservations</span>
                </a>
            </li>
            <li>
                <a class="side-nav__link @(IsActive("Admin", "Reports") ? "is-active" : "")"
                   asp-controller="Admin" asp-action="Reports">
                    <i class="fa-solid fa-chart-line"></i>
                    <span class="side-nav__text">Reports</span>
                </a>
            </li>
            <li>
                <a class="side-nav__link @(IsActive("Admin", "Account") ? "is-active" : "")"
                   asp-controller="Admin" asp-action="Account">
                    <i class="fa-solid fa-user-gear"></i>
                    <span class="side-nav__text">My Account</span>
                </a>
            </li>
        </ul>

        <div class="side-nav__user">
            <button type="button" class="side-nav__link border-0 bg-transparent w-100 text-start" data-bs-toggle="modal" data-bs-target="#logoutWarningModal">
                <i class="fa-solid fa-right-from-bracket"></i>
                <span class="side-nav__text">Logout</span>
            </button>
        </div>
    </nav>
}