@using Microsoft.AspNetCore.Http
@{
    bool isLogin = ViewBag.LoginView == true;
}

@if (!isLogin)
{
    @if (User.IsInRole("Admin"))
    {
        @await Html.PartialAsync("_HeaderAdmin")
    }
    else if (User.IsInRole("Custodian"))
    {
        @await Html.PartialAsync("_HeaderCustodian")
    }
    else
    {
        @await Html.PartialAsync("_HeaderStudent")
    }
}