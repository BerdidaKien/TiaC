@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    bool IsActive(string controller, params string[] actions) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) &&
        (actions == null || actions.Length == 0 ||
         actions.Any(a => string.Equals(currentAction, a, StringComparison.OrdinalIgnoreCase)));
}

@if (ViewBag.LoginView != true)
{
    <aside class="app-sidebar d-flex flex-column h-100">
        <!-- Brand Header -->
        <div class="sidebar-header p-3 text-center border-bottom border-secondary-subtle">
            <h3 class="fw-bold m-0 text-white">TiaC</h3>
            <small class="text-white-50">Equipment Custodian</small>
        </div>

        <!-- Navigation Links -->
        <ul class="nav flex-column p-3 gap-1 flex-grow-1 overflow-y-auto">
            <li class="nav-item">
                <a class="nav-link text-white d-flex align-items-center gap-2 @(IsActive("Custodian", "Index") ? "fw-bold text-warning active" : "")"
                   asp-controller="Custodian" asp-action="Index">
                    <i class="bi bi-speedometer2"></i>
                    <span>Dashboard</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white d-flex align-items-center gap-2 @(IsActive("Custodian", "Equipment") ? "fw-bold text-warning active" : "")"
                   asp-controller="Custodian" asp-action="Equipment">
                    <i class="bi bi-box-seam"></i>
                    <span>Equipment</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white d-flex align-items-center gap-2 @(IsActive("Custodian", "Reservations") ? "fw-bold text-warning active" : "")"
                   asp-controller="Custodian" asp-action="Reservations">
                    <i class="bi bi-calendar-check"></i>
                    <span>Reservations</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white d-flex align-items-center gap-2 @(IsActive("Custodian", "History") ? "fw-bold text-warning active" : "")"
                   asp-controller="Custodian" asp-action="History">
                    <i class="bi bi-clock-history"></i>
                    <span>History</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white d-flex align-items-center gap-2 @(IsActive("Custodian", "Reports") ? "fw-bold text-warning active" : "")"
                   asp-controller="Custodian" asp-action="Reports">
                    <i class="bi bi-bar-chart-line"></i>
                    <span>Reports</span>
                </a>
            </li>

            <li class="nav-item mt-3 border-top border-secondary-subtle pt-3">
                <a class="nav-link text-white d-flex align-items-center gap-2 @(IsActive("Custodian", "Profile") ? "fw-bold text-warning active" : "")"
                   asp-controller="Custodian" asp-action="Profile">
                    <i class="bi bi-person-circle"></i>
                    <span>Profile</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white d-flex align-items-center gap-2 @(IsActive("Custodian", "Settings") ? "fw-bold text-warning active" : "")"
                   asp-controller="Custodian" asp-action="Settings">
                    <i class="bi bi-gear"></i>
                    <span>Settings</span>
                </a>
            </li>
        </ul>

        <!-- Quote -->
        <div class="px-3 py-2 text-center text-white-50 small fst-italic border-top border-secondary-subtle">
            “Better days are ahead,<br />keep going”
        </div>

        <!-- Pinned Bottom Logout -->
        <div class="sidebar-footer p-3 border-top border-secondary-subtle">
            <a asp-controller="Account" asp-action="SignOutUser" class="btn btn-outline-light w-100 btn-sm d-flex align-items-center justify-content-center gap-2">
                <i class="bi bi-box-arrow-left fs-6"></i>
                <span>Logout</span>
            </a>
        </div>
    </aside>
}