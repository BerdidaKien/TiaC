@using System.Linq
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    bool IsActive(string controller, params string[] actions) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) &&
        (actions == null || actions.Length == 0 ||
         actions.Any(a => string.Equals(currentAction, a, StringComparison.OrdinalIgnoreCase)));
}

@if (ViewBag.LoginView != true)
{
    <nav class="side-nav" aria-label="Custodian navigation">
        <a class="side-nav__brand" asp-controller="Custodian" asp-action="Index" aria-label="Go to dashboard">
            TiaC
        </a>

        <ul class="side-nav__links">
            <li>
                <a class="side-nav__link @(IsActive("Custodian", "Index") ? "is-active" : "")"
                   asp-controller="Custodian" asp-action="Index">
                    <i class="fa-solid fa-house"></i>
                    <span class="side-nav__text">Dashboard</span>
                </a>
            </li>
            <li>
                <a class="side-nav__link @(IsActive("Custodian", "Equipment", "AddEquipment", "EditEquipment", "ArchiveEquipment") ? "is-active" : "")"
                   asp-controller="Custodian" asp-action="Equipment">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <span class="side-nav__text">Search Equipments</span>
                </a>
            </li>
            <li>
                <a class="side-nav__link @(IsActive("Custodian", "Reservations") ? "is-active" : "")"
                   asp-controller="Custodian" asp-action="Reservations">
                    <i class="fa-solid fa-calendar"></i>
                    <span class="side-nav__text">All Reservation</span>
                </a>
            </li>
            <li>
                <a class="side-nav__link @(IsActive("Custodian", "History", "HistoryPrint") ? "is-active" : "")"
                   asp-controller="Custodian" asp-action="History">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                    <span class="side-nav__text">History</span>
                </a>
            </li>
            <li>
                <a class="side-nav__link @(IsActive("Custodian", "Reports") ? "is-active" : "")"
                   asp-controller="Custodian" asp-action="Reports">
                    <i class="fa-solid fa-chart-line"></i>
                    <span class="side-nav__text">Reports</span>
                </a>
            </li>
            <li>
                <a class="side-nav__link @(IsActive("Custodian", "Profile") ? "is-active" : "")"
                   asp-controller="Custodian" asp-action="Profile">
                    <i class="fa-solid fa-user"></i>
                    <span class="side-nav__text">Profile</span>
                </a>
            </li>
            <li>
                <a class="side-nav__link @(IsActive("Custodian", "Settings", "SaveSettings") ? "is-active" : "")"
                   asp-controller="Custodian" asp-action="Settings">
                    <i class="fa-solid fa-gear"></i>
                    <span class="side-nav__text">Settings</span>
                </a>
            </li>
        </ul>

        <p class="side-nav__quote">“Better days are ahead, keep going.”</p>

        <div class="side-nav__user">
            <a class="side-nav__link" asp-controller="Account" asp-action="SignOutUser">
                <i class="fa-solid fa-right-from-bracket"></i>
                <span class="side-nav__text">Logout</span>
            </a>
        </div>
    </nav>
}