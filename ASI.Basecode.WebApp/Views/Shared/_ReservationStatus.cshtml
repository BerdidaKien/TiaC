@* Location: ASI.Basecode.WebApp/Views/Shared/_ReservationStatus.cshtml
   Shows where a student's reservation is in its life cycle. *@
@model ASI.Basecode.Data.Models.Reservation
@inject ASI.Basecode.Services.Interfaces.ISettingsService SettingsSvc
@{
    var bt = Model.BorrowingTransaction;
    var showCaption = ViewData["ShowCaption"] is bool b && b;

    string label;
    string css;
    string caption;

    if (bt != null && bt.ActualReturnTime != null)
    {
        label = "Returned";
        css = "is-completed";
        caption = $"Returned {bt.ActualReturnTime:MMM d, h:mm tt}";
    }
    else if (bt != null)
    {
        // The custodian handed the item over and it is not back yet
        var rules = SettingsSvc.Get();
        var now = DateTime.Now;
        var due = Model.EstimatedReturnDate;

        if (due.AddMinutes(rules.OverdueGraceMinutes) < now)
        {
            label = "Overdue";
            css = "is-overdue";
            caption = $"Was due {due:MMM d, h:mm tt} · please return it now";
        }
        else if (due < now)
        {
            // Past the due time but still inside the grace period
            label = "Past due";
            css = "is-borrowed";
            caption = $"Was due {due:MMM d, h:mm tt} · return it as soon as possible";
        }
        else if (due <= now.AddHours(rules.DueSoonHours))
        {
            label = "Due soon";
            css = "is-borrowed";
            caption = $"Return by {due:MMM d, h:mm tt}";
        }
        else
        {
            label = "Active borrow";
            css = "is-available";
            caption = $"Approved · return by {due:MMM d, h:mm tt}";
        }
    }
    else
    {
        switch (Model.Status)
        {
            case "pending":
                label = "Pending";
                css = "is-borrowed";
                caption = "Waiting for the custodian to review";
                break;
            case "approved":
                label = "Waiting for pickup";
                css = "is-pickup";
                caption = $"Approved · pick up {Model.RequestedPickupDate:MMM d, h:mm tt}";
                break;
            case "declined":
                label = "Declined";
                css = "is-declined";
                caption = string.IsNullOrWhiteSpace(Model.ReviewNotes)
                    ? "Declined by the custodian"
                    : "Declined by the custodian · see the notes";
                break;
            case "cancelled":
                label = "Cancelled";
                css = "is-completed";
                caption = "You cancelled this request";
                break;
            default:
                label = Model.Status;
                css = "is-completed";
                caption = null;
                break;
        }
    }
}
<span class="dash-pill @css text-capitalize">@label</span>
@if (showCaption && !string.IsNullOrEmpty(caption))
{
    <div class="rs-caption">@caption</div>
}