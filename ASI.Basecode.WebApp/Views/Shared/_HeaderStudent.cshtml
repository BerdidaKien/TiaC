@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var userName = HttpContextAccessor.HttpContext.Session.GetString("UserName") ?? "Student User";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    bool IsActive(string controller, string action = null) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) &&
        (action == null || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase));
}

<nav class="side-nav" aria-label="Student navigation">
    <a class="side-nav__brand" asp-controller="Student" asp-action="Index" aria-label="Go to dashboard">
        TiaC
    </a>

    <ul class="side-nav__links">
        <li>
            <a class="side-nav__link @(IsActive("Student", "Index") ? "is-active" : "")"
               asp-controller="Student" asp-action="Index">
                <i class="fa-solid fa-house"></i>
                <span class="side-nav__text">Dashboard</span>
            </a>
        </li>
        <li>
            @* The dashboard already lists and filters all equipment *@
            <a class="side-nav__link" asp-controller="Student" asp-action="Equipment">
                <i class="fa-solid fa-magnifying-glass"></i>
                <span class="side-nav__text">Search Equipments</span>
            </a>
        </li>
        <li>
            <a class="side-nav__link @(IsActive("Student", "MyReservations") ? "is-active" : "")"
               asp-controller="Student" asp-action="MyReservations">
                <i class="fa-solid fa-calendar"></i>
                <span class="side-nav__text">My Reservations</span>
            </a>
        </li>
       
        <li>
            <a class="side-nav__link @(IsActive("Student", "History") ? "is-active" : "")"
               asp-controller="Student" asp-action="History">
                <i class="fa-solid fa-clock-rotate-left"></i>
                <span class="side-nav__text">History</span>
            </a>
        </li>
       
        <li>
            <a class="side-nav__link @(IsActive("Account", "Profile") ? "is-active" : "")"
               asp-controller="Account" asp-action="Profile">
                <i class="fa-solid fa-user"></i>
                <span class="side-nav__text">Profile</span>
            </a>
        </li>
       
    </ul>

    <p class="side-nav__quote">“Better days are ahead, keep going.”</p>

    <div class="side-nav__user">
        
            
                <a class="side-nav__link" asp-controller="Account" asp-action="SignOutUser">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    <span class="side-nav__text">Logout</span>
                </a>
            
       
    </div>
</nav>
