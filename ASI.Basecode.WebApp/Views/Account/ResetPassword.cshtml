@model ASI.Basecode.Services.ServiceModels.ResetPasswordViewModel
@section styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Libre+Bodoni:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/login.css" />
}
@{
    ViewBag.LoginView = true;
    ViewData["Title"] = "Set New Password";
}

<div class="fixed-top h-100 overflow-auto login-page">
    <div class="row g-0 no-gutters m-0 min-vh-100">

        <aside class="col-lg-6 login-brand position-relative d-flex align-items-center justify-content-center text-center p-4 p-md-5">
            <div class="login-brand-inner mx-auto">
                <h1 class="login-welcome mb-4">Almost there</h1>
                <p class="login-tagline mb-0">Choose a new password for your account.</p>
            </div>
        </aside>

        <main class="col-lg-6 login-form-panel d-flex align-items-center justify-content-center p-4">
            <div class="w-100 login-form-wrap">
                <h2 class="login-title mb-2">Set new password</h2>
                <p class="login-subtitle mb-4">Use 6 to 50 characters.</p>

                <form method="post" asp-controller="Account" asp-action="ResetPassword" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Token" />

                    <div class="mb-3">
                        <label class="login-label mb-1" for="NewPassword">New password</label>
                        <input type="password" id="NewPassword" class="form-control login-input"
                               asp-for="NewPassword" placeholder="Enter new password" autocomplete="new-password" />
                        <small class="text-muted d-block mt-1">8 to 64 characters, with at least one letter and one number.</small>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="login-label mb-1" for="ConfirmPassword">Confirm password</label>
                        <input type="password" id="ConfirmPassword" class="form-control login-input"
                               asp-for="ConfirmPassword" placeholder="Re-enter new password" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-flex flex-column align-items-center mt-4">
                        <button class="btn login-btn text-white shadow mb-3" type="submit">Save new password</button>
                        <a asp-controller="Account" asp-action="Login" class="small">Back to log in</a>
                    </div>
                </form>
            </div>
        </main>
    </div>
</div>

@section scripts {
    <script>
        var errorMessage = '@TempData["ErrorMessage"]';
        if (errorMessage) { toastr.error(errorMessage); }
    </script>
}