@model ASI.Basecode.Services.ServiceModels.ForgotPasswordViewModel
@section styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Libre+Bodoni:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/login.css" />
}
@{
    ViewBag.LoginView = true;
    ViewData["Title"] = "Forgot Password";
}

<div class="fixed-top h-100 overflow-auto login-page">
    <div class="row g-0 no-gutters m-0 min-vh-100">

        <aside class="col-lg-6 login-brand position-relative d-flex align-items-center justify-content-center text-center p-4 p-md-5">
            <div class="login-brand-inner mx-auto">
                <h1 class="login-welcome mb-4">Forgot your password?</h1>
                <p class="login-tagline mb-0">
                    It happens. Enter your User ID and we'll send a reset link
                    to the email on your account.
                </p>
            </div>
        </aside>

        <main class="col-lg-6 login-form-panel d-flex align-items-center justify-content-center p-4">
            <div class="w-100 login-form-wrap">
                <h2 class="login-title mb-2">Reset password</h2>
                <p class="login-subtitle mb-4">The link expires in 30 minutes.</p>

                <form method="post" asp-controller="Account" asp-action="ForgotPassword" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="login-label mb-1" for="UserId">User ID</label>
                        <input type="text" id="UserId" class="form-control login-input"
                               asp-for="UserId" placeholder="Enter Student or Employee ID" autocomplete="username" />
                        <span asp-validation-for="UserId" class="text-danger small"></span>
                    </div>

                    <div class="d-flex flex-column align-items-center mt-4">
                        <button class="btn login-btn text-white shadow mb-3" type="submit">Send reset link</button>
                        <a asp-controller="Account" asp-action="Login" class="small">Back to log in</a>
                    </div>
                </form>
            </div>
        </main>
    </div>
</div>

@section scripts {
    <script>
        var errorMessage = '@TempData["ErrorMessage"]';
        if (errorMessage) { toastr.error(errorMessage); }
        var successMessage = '@TempData["SuccessMessage"]';
        if (successMessage) { toastr.success(successMessage); }
    </script>
}