@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@section styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Libre+Bodoni:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/dashboard.css" />
}
@functions {
    public class EquipmentItem
    {
        public string Name { get; set; }
        public string Category { get; set; }
        public string Status { get; set; }   // "Available" or "Currently Borrowed"
        public string Icon { get; set; } = "fa-box";
    }

    public class ReservationItem
    {
        public string Name { get; set; }
        public string Dates { get; set; }
        public string Status { get; set; }   // "Active" or "Completed"
        public string Icon { get; set; } = "fa-box";
    }
}
@{
    ViewData["Title"] = "Home Page";

    var userName = HttpContextAccessor.HttpContext.Session.GetString("UserName");
    var fullName = string.IsNullOrWhiteSpace(userName) ? "Guest" : userName;

    // ---- Fill these from your model / database ----
    var equipment = new List<EquipmentItem>();
    var reservations = new List<ReservationItem>();

    int totalEquipment = 0;
    int currentlyBorrowed = 0;
    int pendingReservations = 0;
    int availableNow = 0;

    var stats = new[]
    {
        new { Icon = "fa-cube",          Count = totalEquipment,      Label = "Total Equipment",     LinkText = "View all equipment",      Href = "#" },
        new { Icon = "fa-hand-holding",  Count = currentlyBorrowed,   Label = "Currently Borrowed",  LinkText = "View active reservation", Href = "#" },
        new { Icon = "fa-calendar-days", Count = pendingReservations, Label = "Pending Reservation", LinkText = "View reservations",      Href = "#" },
        new { Icon = "fa-box-archive",   Count = availableNow,        Label = "Available Now",       LinkText = "Browse Equipments",       Href = "#" }
    };
}

<div class="dash">

    @* ===== Welcome header ===== *@
    <div class="dash-header d-flex align-items-start justify-content-between pb-3 mb-4">
        <div>
            <p class="dash-welcome mb-0">Welcome Back,</p>
            <h1 class="dash-name mb-1">@fullName</h1>
            <p class="dash-sub mb-0">Manage your equipment and stay productive.</p>
        </div>

        <div class="d-flex align-items-center">
            <button type="button" class="dash-bell btn" aria-label="Notifications">
                <i class="fa-regular fa-bell"></i>
            </button>
            
        </div>
    </div>

    @* ===== Stat cards ===== *@
    <div class="row">
        @foreach (var s in stats)
        {
            <div class="col-6 col-xl-3 mb-4">
                <div class="dash-card dash-stat h-100">
                    <div class="d-flex align-items-center mb-3">
                        <span class="dash-icon-circle dash-icon-lg d-inline-flex align-items-center justify-content-center">
                            <i class="fa-solid @s.Icon"></i>
                        </span>
                        <span class="dash-stat-count ml-3 ms-3">@s.Count</span>
                    </div>
                    <h3 class="dash-stat-label">@s.Label</h3>
                    <a href="@s.Href" class="dash-link">
                        @s.LinkText <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </div>
        }
    </div>

    <div class="row dash-bottom">

        @* ===== Available equipments ===== *@
        <div class="col-lg-8 mb-4 dash-col">
            <div class="dash-card">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h2 class="dash-section-title mb-0">Available Equipments</h2>
                    <a href="#" class="dash-link">View all <i class="fa-solid fa-arrow-right"></i></a>
                </div>

                <div class="dash-search position-relative mb-3">
                    <i class="fa-solid fa-magnifying-glass dash-search-icon"></i>
                    <input type="text" id="equipmentSearch" class="form-control dash-search-input"
                           placeholder="Search for equipment..." aria-label="Search for equipment" />
                </div>

                <div class="table-responsive dash-scroll">
                    <table class="table dash-table mb-0" id="equipmentTable">
                        <thead>
                            <tr>
                                <th>Equipment Name</th>
                                <th>Category</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var e in equipment)
                            {
                                var available = e.Status == "Available";
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <span class="dash-icon-circle dash-icon-sm d-inline-flex align-items-center justify-content-center">
                                                <i class="fa-solid @e.Icon"></i>
                                            </span>
                                            <span class="ml-2 ms-2">@e.Name</span>
                                        </div>
                                    </td>
                                    <td>@e.Category</td>
                                    <td>
                                        <span class="dash-pill @(available ? "is-available" : "is-borrowed")">@e.Status</span>
                                    </td>
                                    <td>
                                        @if (available)
                                        {
                                            <a href="#" class="btn dash-btn dash-btn-reserve">Reserve</a>
                                        }
                                        else
                                        {
                                            <a href="#" class="btn dash-btn dash-btn-view">View</a>
                                        }
                                    </td>
                                </tr>
                            }
                            <tr id="noResults" class="@(equipment.Any() ? "d-none" : "")">
                                <td colspan="4" class="text-center dash-muted">
                                    @(equipment.Any() ? "No equipment found." : "No equipment available yet.")
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @* ===== Recent reservations ===== *@
        <div class="col-lg-4 mb-4 dash-col">
            <div class="dash-card">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h2 class="dash-section-title mb-0">Recent Reservations</h2>
                    <a href="#" class="dash-link">View all <i class="fa-solid fa-arrow-right"></i></a>
                </div>

                @if (!reservations.Any())
                {
                    <p class="dash-muted text-center mb-0 py-4">No reservations yet.</p>
                }

                <ul class="dash-reservations dash-scroll list-unstyled mb-0">
                    @foreach (var r in reservations)
                    {
                        <li class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center">
                                <span class="dash-icon-circle dash-icon-sm d-inline-flex align-items-center justify-content-center">
                                    <i class="fa-solid @r.Icon"></i>
                                </span>
                                <div class="ml-2 ms-2">
                                    <div class="dash-res-name">@r.Name</div>
                                    <div class="dash-res-date"><i class="fa-regular fa-calendar"></i> @r.Dates</div>
                                </div>
                            </div>
                            <span class="dash-pill @(r.Status == "Active" ? "is-available" : "is-completed")">@r.Status</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        // Live search for the equipment table
        (function () {
            var input = document.getElementById('equipmentSearch');
            var rows = document.querySelectorAll('#equipmentTable tbody tr:not(#noResults)');
            var empty = document.getElementById('noResults');
            if (!input) return;

            input.addEventListener('input', function () {
                var term = input.value.trim().toLowerCase();
                var shown = 0;
                rows.forEach(function (row) {
                    var match = row.textContent.toLowerCase().indexOf(term) !== -1;
                    row.classList.toggle('d-none', !match);
                    if (match) shown++;
                });
                empty.classList.toggle('d-none', shown !== 0);
            });
        })();
    </script>
}
