@* Location: ASI.Basecode.WebApp/Views/Student/EquipmentDetails.cshtml *@
@model ASI.Basecode.Data.Models.EquipmentItem
@{
    ViewData["Title"] = "Equipment Details";

    var available = Model.Status == "available";
    var statusLabel = available ? "Available" : (Model.Status == "borrowed" ? "Currently Borrowed" : Model.Status);
    var rules = ViewBag.Rules as ASI.Basecode.Services.ServiceModels.BorrowingSettings
                ?? new ASI.Basecode.Services.ServiceModels.BorrowingSettings();
    var nowTime = DateTime.Now;
    var minValue = nowTime.ToString("yyyy-MM-dd'T'HH:mm");
    var maxValue = nowTime.AddDays(rules.AdvanceBookingDays).ToString("yyyy-MM-dd'T'HH:mm");
    string Clock(string hhmm) => DateTime.Today.Add(TimeSpan.Parse(hhmm)).ToString("h:mm tt");

    string IconFor(string categoryCode) => (categoryCode ?? "") switch
    {
        "AV-MEDIA" => "bi-camera",
        "IT-TECH" => "bi-laptop",
        "EVENT-SUP" => "bi-megaphone",
        "LAB-SCI" => "bi-eyedropper",
        "SPORTS-REC" => "bi-trophy",
        "GEN-TOOLS" => "bi-tools",
        _ => "bi-box-seam"
    };
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Libre+Bodoni:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <style>
        .rd-photo {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 16rem;
            background: #fff;
            border-radius: 10px;
            overflow: hidden;
            font-size: 4rem;
            color: var(--d-maroon);
        }
        .rd-photo img { width: 100%; height: 100%; object-fit: cover; }
        .rd-info dt { font-size: .75rem; text-transform: uppercase; letter-spacing: .5px; color: var(--d-red); font-weight: 700; }
        .rd-info dd { margin-bottom: .8rem; }
    </style>
}

<div class="dash">

    <div class="dash-header pb-3 mb-4">
        <a asp-controller="Student" asp-action="Equipment" class="dash-link d-inline-block mb-2">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to equipment
        </a>
        <h1 class="dash-name mb-1">@Model.BrandModel</h1>
        <p class="dash-sub mb-0">@(Model.Category?.CategoryName ?? "Equipment")</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">

        @* ===== Item details ===== *@
        <div class="col-lg-6">
            <div class="dash-card h-100">
                <div class="rd-photo mb-3">
                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <img src="@Model.ImagePath" alt="@Model.BrandModel" />
                    }
                    else
                    {
                        <i class="bi @IconFor(Model.Category?.CategoryCode)"></i>
                    }
                </div>

                <dl class="rd-info mb-0">
                    <dt>Status</dt>
                    <dd><span class="dash-pill @(available ? "is-available" : "is-borrowed")">@statusLabel</span></dd>

                    <dt>Item code</dt>
                    <dd>@Model.ItemCode</dd>

                    <dt>Condition</dt>
                    <dd class="text-capitalize">@Model.ConditionRating?.Replace("_", " ")</dd>

                    <dt>Storage location</dt>
                    <dd class="mb-0">@Model.StorageLocation</dd>
                </dl>
            </div>
        </div>

        @* ===== Reservation form ===== *@
        <div class="col-lg-6">
            <div class="dash-card h-100">
                <h2 class="dash-section-title mb-3">Reserve this equipment</h2>

                @if (available)
                {
                    <form asp-controller="Student" asp-action="Reserve" method="post">
                        <input type="hidden" name="equipmentItemId" value="@Model.Id" />

                        <div class="mb-3">
                            <label class="dash-stat-label mb-1" for="pickupDate">Pickup date &amp; time</label>
                            <input type="datetime-local" id="pickupDate" name="pickupDate" min="@minValue" max="@maxValue"
                                   class="form-control dash-search-input" required />
                        </div>

                        <div class="mb-3">
                            <label class="dash-stat-label mb-1" for="returnDate">Return date &amp; time</label>
                            <input type="datetime-local" id="returnDate" name="returnDate" min="@minValue"
                                   class="form-control dash-search-input" required />
                            <div class="form-text">Pick the pickup time first. The return time is filled in for you.</div>
                        </div>

                        <div class="dash-muted small mb-3">
                            <i class="bi bi-info-circle me-1"></i> Borrowing rules
                            <ul class="mb-0 ps-3 mt-1">
                                <li>Pickup and return between <strong>@Clock(rules.OpeningTime)</strong> and <strong>@Clock(rules.ClosingTime)</strong>.</li>
                                <li>Borrow for up to <strong>@rules.MaxDurationDays day(s)</strong>.</li>
                                <li>Reserve up to <strong>@rules.AdvanceBookingDays day(s)</strong> ahead.</li>
                                <li>At most <strong>@rules.MaxActiveItems item(s)</strong> at a time, counting pending, approved and borrowed.</li>
                            </ul>
                            <div class="mt-2">
                                Your request is sent to the custodian, who will approve or decline it.
                                You can follow its status under <strong>My Reservations</strong>.
                            </div>
                        </div>

                        <button type="submit" class="btn dash-btn-reserve w-100">
                            <i class="bi bi-send me-1"></i> Send reservation request
                        </button>
                    </form>
                }
                else
                {
                    <div class="dash-muted text-center py-4">
                        <i class="bi bi-hourglass-split fs-2 d-block mb-2"></i>
                        This item is not available for reservation right now.<br />
                        Please check back later or choose another item.
                        <div class="mt-3">
                            <a asp-controller="Student" asp-action="Equipment" class="btn dash-btn-view">Browse equipment</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var DEFAULT_HOURS = @rules.DefaultDurationHours;
            var MAX_DAYS = @rules.MaxDurationDays;

            var pickup = document.getElementById('pickupDate');
                    var ret = document.getElementById('returnDate');
            if (!pickup || !ret) return;

                 function pad(n) { return (n < 10 ? '0' : '') + n; }
                function fmt(d) {
                return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) +
                       'T' + pad(d.getHours()) + ':' + pad(d.getMinutes());
            }

                    pickup.addEventListener('change', function () {
                        if (!pickup.value) return;
                        var start = new Date(pickup.value);

                        // The return time can't be before the pickup or later than the longest allowed borrowing
                        ret.min = pickup.value;
                        ret.max = fmt(new Date(start.getTime() + MAX_DAYS * 86400000));

                        // Fill in the default duration when empty or no longer valid
                        if (!ret.value || ret.value <= pickup.value || ret.value > ret.max) {
                            ret.value = fmt(new Date(start.getTime() + DEFAULT_HOURS * 3600000));
                        }
                    });
                })();
    </script>
}
